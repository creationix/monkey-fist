// Encantis 0.2.1: arithmetic that is the right operand of a comparison is
// compiled with the comparison's type instead of its own.
//   encantis test 03-arithmetic-right-of-comparison.ents     -> the first two tests fail
//   encantis compile 03-arithmetic-right-of-comparison.ents
//     $below_half:  (i32.lt_s (local.get $a) (i32.div_u (local.get $b) (local.get $c)))    div_u on i32
//     $below_sum64: (i64.lt_s (local.get $a) (i64.extend_i32_u (i32.add (i32.wrap_i64 ...  the sum is cut to 32 bits
// With f64 operands the same thing gives invalid wasm, so at least it is reported
// (uncomment $enough): "type mismatch in i32.mul, expected [i32, i32] but got [f64, f64]".
// The same arithmetic on the left of the comparison, or taken into a local, is right.
// Workaround used in weave.ents (best_rope): a local for the right-hand side.

func below_half(a: i32, b: i32, c: i32) -> bool => a < b / c
func below_sum64(a: i64, b: i64, c: i64) -> bool => a < b + c
func half_above(a: i32, b: i32, c: i32) -> bool => b / c > a
// func enough(covered: f64, area: f64) -> bool => covered >= 0.72 * area

test "a < b / c divides signed numbers as signed" {
  assert !below_half(5, -6, 2)         // 5 < -3 is false
}

test "a < b + c adds in 64 bits" {
  assert below_sum64(5000000000, 4000000000, 4000000000)
}

test "the same division on the left is right" {
  assert !half_above(5, -6, 2)
}
