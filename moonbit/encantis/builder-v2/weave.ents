// The square woven builder: weave(rng, cfg) of levels.js at 9e69e3a, now
// src/core/weave.mbt. A sliding level is built backwards from the solved board,
// together with a way to solve it: each step lays one more rope (or a knot, or
// a trap) and is kept only if the board still replays (board.ents). Every
// random draw is made in the same order as the JS, so the same seed weaves the
// same board. check-weave.cjs holds it to that; its header is the contract for
// the buffers below.
//
// In the JS, weave is one function with some 25 closures over its locals. Here
// those locals are module globals, set up again by every call, and the closures
// are top-level functions.
//
// Memory is the bump stack, in scopes:
//   the call   the board's tables, the ropes' tracks, the tables below
//   a step     what survey() finds, the places for a knot or trap
//   a try      one candidate: its lanes, its cells, the rope's trial on the board
// A scope frees everything on the way out (defer). Three things follow from it:
//   - A candidate is tried in a scope of its own, so the step's choice is copied
//     out of it, to buffers that last for the call (keep).
//   - A rope's track has to last for the call, so commit() runs only when no
//     scope but the call's is open. It asserts that.
//   - A function that returns a list builds it in its caller's scope.

import "./lib/stack" (
  "mark" func mark() -> u32
  "reset" func reset(m: u32)
  "alloc" func alloc(n: u32) -> u32
)

import "./ints" (
  "ints" func ints(n: i32) -> [*]mut i32
  "ints_of" func ints_of(n: i32, v: i32) -> [*]mut i32
  "fill" func fill(p: [*]mut i32, n: i32, v: i32)
  "span" func span(p: [*]i32, n: i32) -> []i32
  "part" func part(p: [*]i32, from: i32, to: i32) -> []i32
  "nothing" func nothing() -> []i32
  "begin" func begin() -> u32
  "push" func push(v: i32)
  "push_reversed" func push_reversed(xs: []i32)
  "since" func since(start: u32) -> []i32
  "contains" func contains(xs: []i32, v: i32) -> bool
  "reversed" func reversed(xs: []i32) -> []i32
  "copy_to" func copy_to(dst: [*]mut i32, xs: []i32)
)

import "./rng" (
  "seed" func seed(s: u32)
  "draws" func draw_count() -> u32
  "trace_at" func trace_at() -> u32
  "rng" func rng(site: u32, n: i32) -> f64
  "below" func below(site: u32, n: i32) -> i32
  "chance" func chance(site: u32, p: f64) -> bool
)

import "./board" (
  "width" global width: i32
  "height" global height: i32
  "area" global area: i32
  "slope" global slope: [*]mut i32
  "mirrors" global mirrors: i32
  "mirror_at" global mirror_at: [*]mut i32
  "n" global n: i32
  "seq" global seq: [*]mut []i32
  "len" global len: [*]mut i32
  "stops" global stops: [*]mut []i32
  "cost" global cost: [*]mut i32
  "dep" global dep: [*]mut i32
  "taps" global taps: [*]mut i32
  "ntaps" global ntaps: i32
  "cost_sum" global cost_sum: i32
  "new_board" func new_board(w: i32, h: i32, max_taps: i32)
  "add_mirror" func add_mirror(c: i32, kind: i32)
  "head_dir" func head_dir(path: []i32) -> (dx: i32, dy: i32)
  "ray" func ray(x: i32, y: i32, dx: i32, dy: i32) -> bool
  "self_blocked" func self_blocked(path: []i32) -> bool
  "add" func add(path: []i32, st: []i32) -> i32
  "drop" func drop()
  "path_of" func path_of(i: i32) -> []i32
  "place" func place(i: i32, to: i32)
  "set_up" func set_up()
  "slide_to" func slide_to(i: i32) -> i32
  "relax" func relax() -> i32
  "plays_out" func plays_out(order: []i32) -> bool
  "replay" func replay(list: []i32, fresh: i32) -> bool
  "replay_first" func replay_first(id: i32, order: []i32) -> bool
  "trial" func trial(path: []i32, st: []i32, order: []i32) -> i32
  "find_loops" func find_loops(looped: [*]mut i32)
)

export "mem" memory

data inbuf = mut [0:u8; 65536]    // i32 words in
data finbuf = mut [0:u8; 64]      // 8 f64 in
data outbuf = mut [0:u8; 65536]   // i32 words out

export func in_ptr() -> u32 => inbuf as u32
export func fin_ptr() -> u32 => finbuf as u32
export func out_ptr() -> u32 => outbuf as u32
export func draws() -> u32 => draw_count()
export func trace_ptr() -> u32 => trace_at()

func word(k: i32) -> i32 => inbuf.i32[k]

// Input words from..from + count, as a list: core ropes, their stops and the
// plan are used where they lie.
func words(from: i32, count: i32) -> []i32 => part(inbuf as [*]i32, from, from + count)

// --- Constants ---------------------------------------------------------------

// Marks on the starting board besides rope ids and -1 (empty): a cell being
// walked, a cell held empty in front of a trap, and a fixed mirror (ropes pass
// over one, but none may lie on it).
def walked = -2:i32
def held = -3:i32
def mirror = -4:i32

def min_ropes = 3:i32
def min_coverage_slide = 0.72:f64   // share of cells that must hold rope
def min_coverage_small = 0.6:f64    // ... on the narrowest boards
def min_blocked_share = 0.5:f64     // share of ropes that must be blocked, beyond the narrowest boards
def small_w = 5:i32
def knot_tries = 12             // tries per step at a knot, and as many again at a trap
def tries_per_step = 6          // ropes tried per step
def max_stuck = 4:i32           // failed steps in a row that end the laying

// The score slot [lo, hi). The generator always asks for [0, 1000000) and sets
// tapDepth, so, like the MoonBit port, this one fixes the whole-number scores
// inside the slot and drops cfg.lo, hi, bends, wantAvg and floor.
def s_min = 0:i32
def s_max = 999999:i32

// Directions 0 to 3: +x, +y, -x, -y.
data dir_x = [1, 0, -1, 0]
data dir_y = [0, 1, 0, -1]

func dx_of(d: i32) -> i32 => dir_x.i32[d]
func dy_of(d: i32) -> i32 => dir_y.i32[d]

// The kinds of rope a step tries: where a new rope starts.
def deep = 0:i32        // across the way out of a free rope, favouring long chains waiting on it
def leaf = 1:i32        // across the way out of any free rope
def inner = 2:i32       // across the way out of a rope already blocked
def any = 3:i32         // anywhere
def plain = 4:i32       // anywhere, and running straight
def at_mirror = 5:i32   // aimed at a mirror no rope uses yet

// The kinds a step goes through, try by try (it makes 6 tries). Rows: an empty
// board; no budget left; then by the block cost wanted of the new rope: 2 or
// more, 1 or more, less.
data kinds = [
  any, any, any, any, any, any, any, any,
  plain, plain, plain, plain, plain, plain, plain, plain,
  deep, deep, leaf, inner, deep, any, leaf, inner,
  leaf, inner, any, leaf, inner, plain, any, leaf,
  inner, any, plain, inner, any, plain, inner, any
]

// --- What the builder is asked for (cfg) ---------------------------------------

global len_lo: i32 = 0        // rope lengths wanted: len_lo to len_hi
global len_hi: i32 = 0
global min_len: i32 = 0       // the shortest rope kept
global tie: i32 = 0           // knots wanted
global bait: i32 = 0          // traps wanted
global pull: i32 = 0          // the longest slide
global straight: f64 = 0.0    // the chance a growing rope carries straight on
global tap_depth: f64 = 0.0   // the block cost each new rope should add
global mean_len: f64 = 0.0
global cover_goal: f64 = 0.0  // cells to fill before the laying stops

// --- The build so far: the locals of the JS weave() ------------------------------

global grid: [*]mut i32 = 0         // the board as the level starts: per cell a rope id, -1, or a mark
global rest: [*]mut i32 = 0         // per cell: the knot that will come to rest here (it is empty for now), or -1
global mirror_used: [*]mut i32 = 0  // per cell: 1 once the mirror here lies on some rope's track
global mirrors_used: i32 = 0
global order: [*]mut i32 = 0        // the ropes in the order the last replay first tapped them
global norder: i32 = 0
global total0: i32 = 0              // the total block cost of the board as it stands
global bend_sum: i32 = 0
global covered: i32 = 0             // cells under rope
global knots: i32 = 0
global traps: i32 = 0

// What survey() found, for one step.
global ahead: [*]mut []i32 = 0      // per rope: the empty cells on its way out, along the track
global blk: [*]mut []i32 = 0        // per rope: the ropes on its way out
global lanes: [*]mut []mut i32 = 0  // per cell: the ropes whose way out crosses it (empty cells only)
global up: [*]mut i32 = 0           // per rope: roughly how long a chain of ropes waits on it

// mark_below() stamps the ropes it reaches.
global waits: [*]mut i32 = 0
global stamp: i32 = 0

// The step's choice, copied out of the scope it was tried in (keep).
global kept_path: [*]mut i32 = 0
global kept_rest: [*]mut i32 = 0
global kept_gap: [*]mut i32 = 0
global path_room: i32 = 0

// The top of the stack whenever only the call's scope is open: commit() checks
// it, because the track it adds must not be freed by a step or a try.
global settled: u32 = 0

// --- Values ------------------------------------------------------------------------
// `ok` stands in for an optional: when it is false the rest means nothing.

// A way out: every cell to the edge, how many are empty, the ropes standing in it.
type Lane = (ok: bool, cells: []i32, free: i32, ids: []i32)

// A rope shaped on the board: its path from tail to head and its way out.
type Shaped = (ok: bool, path: []i32, lane: Lane)

// A candidate addition, with what it would do to the score: a rope (lane set),
// a knot (pull > 0: how far back it starts; rest: the cells it slides onto) or a
// trap (gap: the cells kept empty in front of it).
type Cand = (ok: bool, path: []i32, lane: Lane, gain: i32, bends: i32, pull: i32, rest: []i32, gap: []i32)

// A place for a knot or trap: an empty cell for the head and a direction. For a
// knot, `room` is the straight room behind and `against` the knot it would come
// to rest against, or -1 if a rope is there now. For a trap, `gap` is the empty
// run ahead.
type Spot = (c: i32, di: i32, room: i32, against: i32, gap: i32)

type Spots = (tight: []Spot, chain: []Spot, gapped: []Spot)

// A direction a new rope's head could point, with its way out. (Lane's fields
// again, because 0.2.1 cannot read a slice out of a struct nested in a struct
// in memory, and shape() keeps a list of these.)
type Option = (d: i32, free: i32, cells: []i32, ids: []i32)

// A walked rope: its body cells from the head back, and for a knot its tail.
type Walked = (ok: bool, cells: []i32, tail: []i32)

func no_lane() -> Lane => Lane(false, nothing(), 0, nothing())
func no_shape() -> Shaped => Shaped(false, nothing(), no_lane())
func no_cand() -> Cand => Cand(false, nothing(), no_lane(), 0, 0, 0, nothing(), nothing())
func no_walk() -> Walked => Walked(false, nothing(), nothing())

func inside(x: i32, y: i32) -> bool => x >= 0 && y >= 0 && x < width && y < height

func order_list() -> []i32 => span(order, norder)

func bends_of(path: []i32) -> i32 {
  let p = path.ptr
  let bends = 0
  for i in path.len {
    continue when i < 2
    let ax = p[i - 2] % width
    let ay = p[i - 2] / width
    let bx = p[i - 1] % width
    let by = p[i - 1] / width
    if p[i] % width - bx != bx - ax || p[i] / width - by != by - ay {
      bends += 1
    }
  }
  return bends
}

// --- Shaping ropes (shaper in levels.js) ----------------------------------------------

// A random walk through empty cells from `start`, with its first step forced in
// direction `first` unless that is -1. `straightness` is the chance each step
// carries straight on. Returns the cells, `start` first.
func grow(start: i32, first: i32, straightness: f64) -> []i32 {
  let want = len_lo + below(1, len_hi - len_lo + 1)
  let cells = ints(max(want, 1))
  let opts = ints(4)
  cells[0] = start
  let count = 1
  let last = -1
  grid[start] = walked
  while count < want {
    let c = cells[count - 1]
    let x = c % width
    let y = c / width
    let open = 0
    for d in 4 {
      let nx = x + dir_x[d]
      let ny = y + dir_y[d]
      if inside(nx, ny) && grid[ny * width + nx] == -1 {
        opts[open] = d as i32
        open += 1
      }
    }
    break when open == 0
    let go = first
    if count > 1 || first < 0 {
      go = if last >= 0 && contains(span(opts, open), last) && chance(2, straightness) { last } else { opts[below(3, open)] }
    } elif !contains(span(opts, open), first) {
      break
    }
    last = go
    let nc = (y + dy_of(go)) * width + x + dx_of(go)
    cells[count] = nc
    count += 1
    grid[nc] = walked
  }
  let grown = span(cells, count)
  for cell in grown {
    grid[cell] = -1
  }
  return grown
}

// The way out from (x, y) in direction (dx, dy), not counting (x, y) itself.
// With mirrors it bends; not ok if it would pass a cell twice.
func way_out(x: i32, y: i32, dx: i32, dy: i32) -> Lane {
  let start = begin()
  return no_lane() when !ray(x, y, dx, dy)
  let cells = since(start)
  let free = 0
  let found = begin()
  for c in cells {
    let o = grid[c]
    if o == -1 {
      free += 1
    } elif o >= 0 && !contains(since(found), o) {
      push(o)
    }
  }
  return Lane(true, cells, free, since(found))
}

// The way out of a rope with this path, or not ok if its own body is in it.
func lane_of(path: []i32) -> Lane {
  return no_lane() when self_blocked(path)
  let h = path.ptr[path.len - 1]
  let dx, dy = head_dir(path)
  let lane = way_out(h % width, h / width, dx, dy)
  assert lane.ok
  return lane
}

// Shapes a rope that includes `start`. Usually head first: point the head from
// `start` (longer ways out favoured: they cross more of the board) and lay the
// body out behind it; `dir`, unless -1, is the one direction the head may
// point. Otherwise walk a body through `start` and take whichever end has the
// longer way out.
func shape(start: i32, straightness: f64, dir: i32) -> Shaped {
  let sx = start % width
  let sy = start / width
  if dir >= 0 || chance(4, 0.75) {
    // The directions the head could point, each with its way out.
    let opts = alloc(4 * sizeof(Option)) as [*]mut Option
    let open = 0
    let sum = 0
    for d in 4 {
      continue when dir >= 0 && d as i32 != dir
      // the body's first cell sits behind the head
      let bx = sx - dir_x[d]
      let by = sy - dir_y[d]
      continue when !inside(bx, by) || grid[by * width + bx] != -1
      let lane = way_out(sx, sy, dir_x[d], dir_y[d])
      continue when !lane.ok
      opts[open].d = d as i32
      opts[open].free = lane.free
      opts[open].cells = lane.cells
      opts[open].ids = lane.ids
      open += 1
      sum += lane.cells.len as i32 + 1
    }
    if open > 0 {
      // one of them, by weight: the length of its way out, plus one
      let r = rng(5, sum) * sum
      let o = open - 1
      for k in open {
        r -= opts[k].cells.len + 1
        if r < 0.0 {
          o = k as i32
          break
        }
      }
      let behind = grow(start, (opts[o].d + 2) % 4, straightness)
      let path = reversed(behind)
      if behind.len as i32 >= min_len && !self_blocked(path) {
        let cells = opts[o].cells
        let ids = opts[o].ids
        return Shaped(true, path, Lane(true, cells, opts[o].free, ids))
      }
    }
    return no_shape() when dir >= 0
  }
  let body = grow(start, -1, straightness)
  return no_shape() when (body.len as i32) < min_len
  let back = reversed(body)
  let a = lane_of(body)
  let b = lane_of(back)
  if a.ok && b.ok {
    if b.cells.len > a.cells.len || (b.cells.len == a.cells.len && chance(6, 0.5)) {
      return Shaped(true, back, b)
    }
    return Shaped(true, body, a)
  }
  return Shaped(true, body, a) when a.ok
  return Shaped(true, back, b) when b.ok
  return no_shape()
}

// --- Adding to the board ----------------------------------------------------------------

func fits(c: Cand, budget: i32) -> bool => c.ok && c.gain + c.bends <= budget && bend_sum + c.bends <= s_max

// Copies a candidate's cells to the buffers that last for the call, so that it
// outlives the scope it was tried in. There is one set of buffers: keeping a
// candidate overwrites the one kept before.
func keep(c: Cand) -> Cand {
  assert c.path.len as i32 <= path_room && c.rest.len as i32 <= pull && c.gap.len as i32 <= pull
  copy_to(kept_path, c.path)
  copy_to(kept_rest, c.rest)
  copy_to(kept_gap, c.gap)
  return Cand(true, span(kept_path, c.path.len as i32), no_lane(), c.gain, c.bends, c.pull,
    span(kept_rest, c.rest.len as i32), span(kept_gap, c.gap.len as i32))
}

// order = the ropes in the order the last replay first tapped them: the order
// to try them in next time.
func note_order() {
  norder = 0
  for i in span(taps, ntaps) {
    if !contains(span(order, norder), i) {
      order[norder] = i
      norder += 1
    }
  }
}

// Adds a kept candidate to the board for good.
func commit(c: Cand) {
  // What is allocated here lasts for the rest of the call, so no step or try
  // may be open: its reset would free the track.
  assert mark() == settled
  let st = nothing()
  if c.pull > 0 {
    let one = begin()
    push(c.pull)
    st = since(one)
  }
  let id = add(c.path, st)
  settled = mark()
  if mirrors > 0 {
    for cell in seq[id] {
      if slope[cell] >= 0 && mirror_used[cell] == 0 {
        mirror_used[cell] = 1
        mirrors_used += 1
      }
    }
  }
  replay_first(id, order_list())
  total0 = cost_sum
  note_order()
  for cell in path_of(id) {
    grid[cell] = id
  }
  covered += len[id]
  bend_sum += c.bends
  if c.pull > 0 {
    knots += 1
    for cell in c.rest {
      rest[cell] = id
    }
  }
  if c.gap.len > 0 {
    traps += 1
    for cell in c.gap {
      if grid[cell] == -1 {
        grid[cell] = held
      }
    }
  }
}

// --- How the board stands --------------------------------------------------------------------

// Fills ahead, blk, lanes and up for the board as the level starts. In the
// caller's scope: they last for the step.
func survey() {
  ahead = alloc((n as u32) * 8) as [*]mut []i32
  blk = alloc((n as u32) * 8) as [*]mut []i32
  let crossed = ints_of(area, 0)   // per cell: how many ways out cross it
  for i in n {
    let track = seq[i].ptr
    let total = seq[i].len as i32
    // Two lists grow in turns here. The empty cells get room for the whole way
    // out; the ropes are pushed on top.
    let free = ints(total - len[i])
    let count = 0
    let found = begin()
    for c in part(track, len[i], total) {
      let o = grid[c]
      if o == -1 {
        free[count] = c
        count += 1
        crossed[c] += 1
      } elif o >= 0 && !contains(since(found), o) {
        push(o)
      }
    }
    let ids = since(found)
    blk[i] = ids
    let cells = span(free, count)
    ahead[i] = cells
  }
  // lanes[cell] grows as the ropes are gone through, every cell's list in turn:
  // each gets the room counted for it above, and is filled in rope order.
  lanes = alloc((area as u32) * 8) as [*]mut []mut i32
  for cell in area {
    let room: []mut i32 = (ints(crossed[cell]), 0:u32)
    lanes[cell] = room
  }
  for rope in n {
    for c in ahead[rope] {
      lanes[c].ptr[lanes[c].len] = rope as i32
      lanes[c].len += 1
    }
  }
  // up, from the costs and waits the last replay left. By cost, highest first:
  // the sort must be stable (ropes of equal cost stay in the order of `order`),
  // so an insertion sort.
  fill(up, n, 0)
  let by_cost = ints(norder)
  for k in norder {
    let id = order[k]
    let j = k as i32
    while j > 0 && cost[by_cost[j - 1]] < cost[id] {
      by_cost[j] = by_cost[j - 1]
      j -= 1
    }
    by_cost[j] = id
  }
  for x in span(by_cost, norder) {
    let d = dep[x]
    if d >= 0 && up[x] + 1 > up[d] {
      up[d] = up[x] + 1
    }
  }
}

// --- Candidate ropes ---------------------------------------------------------------------------

func parent_weight(kind: i32, i: i32) -> i32 {
  return 0 when ahead[i].len == 0
  if kind == inner {
    return 1 when cost[i] > 0
    return 0
  }
  return 0 when cost[i] > 0
  return (up[i] + 1) * (up[i] + 1) when kind == deep
  return 1
}

// Picks a rope to lay the next one across, by weight, or -1 if none will do.
func pick_parent(kind: i32) -> i32 {
  let sum = 0
  for i in n {
    sum += parent_weight(kind, i as i32)
  }
  return -1 when sum == 0
  let r = rng(7, sum) * sum
  for j in n {
    r -= parent_weight(kind, j as i32)
    return j as i32 when r < 0.0
  }
  return n - 1
}

// A start for a head 1 to 3 cells before an unused mirror, pointing at it.
func aimed() -> (ok: bool, start: i32, di: i32) {
  ok = false
  let scope = mark()
  defer reset(scope)
  let found = begin()
  for c in span(mirror_at, mirrors) {
    if mirror_used[c] == 0 {
      push(c)
    }
  }
  let idle = since(found)
  if idle.len == 0 {
    return
  }
  let m = idle.ptr[below(8, idle.len as i32)]
  di = below(9, 4)
  let j = 1 + below(10, 3)
  let x = m % width - dx_of(di) * j
  let y = m / width - dy_of(di) * j
  if !inside(x, y) {
    return
  }
  for k in j {
    let step = k as i32
    if grid[(y + dy_of(di) * step) * width + x + dx_of(di) * step] != -1 {
      return
    }
  }
  start = y * width + x
  ok = true
}

// One possible next rope, with what it would do to the score. `at` is the cell
// it must include, or -1 to choose one by `kind`.
func candidate(kind: i32, at: i32) -> Cand {
  let start = at
  let dir = -1
  if kind == at_mirror {
    let (ok:, start: cell, di:) = aimed()
    return no_cand() when !ok
    start = cell
    dir = di
  }
  let parent = -1
  if start < 0 && kind != any && kind != plain {
    parent = pick_parent(kind)
  }
  if parent >= 0 {
    start = ahead[parent].ptr[below(11, ahead[parent].len as i32)]
  }
  let tries = 0
  while start < 0 && tries < 6 {
    let c = below(12, area)
    if grid[c] == -1 {
      start = c
    }
    tries += 1
  }
  return no_cand() when start < 0
  let s = shape(start, if kind == plain { 1.0 } else { straight }, dir)
  return no_cand() when !s.ok
  let sum = trial(s.path, nothing(), order_list())
  return no_cand() when sum < 0
  return Cand(true, s.path, s.lane, sum - total0, bends_of(s.path), 0, nothing(), nothing())
}

// --- Knots and traps ------------------------------------------------------------------------------

// Where a knot or trap could go on the starting board: an empty cell for the
// head and a direction, with something to stop against directly ahead (and how
// much straight room there is behind), or a rope a gap ahead. `tight` spots are
// against a rope that is there now; `chain` spots are against the place another
// knot will come to rest, so that the two have to be slid in the right order;
// `gapped` spots have a rope a short gap ahead.
func knot_spots() -> Spots {
  // The three lists grow in turns, so each gets room for every cell and
  // direction: 4 * area spots of 20 bytes.
  let room_for = (area as u32) * 4 * sizeof(Spot)
  let tight = alloc(room_for) as [*]mut Spot
  let chain = alloc(room_for) as [*]mut Spot
  let gapped = alloc(room_for) as [*]mut Spot
  let ntight = 0
  let nchain = 0
  let ngapped = 0
  for cell in area {
    let c = cell as i32
    continue when grid[c] != -1
    let x = c % width
    let y = c / width
    for d in 4 {
      let dx = dir_x[d]
      let dy = dir_y[d]
      let ax = x + dx
      let ay = y + dy
      continue when !inside(ax, ay)
      let o = grid[ay * width + ax]
      let against = if o == -1 { rest[ay * width + ax] } else { -1 }
      if o >= 0 || against >= 0 {
        let room = 0
        let bx = x - dx
        let by = y - dy
        while room <= pull && inside(bx, by) && grid[by * width + bx] == -1 {
          room += 1
          bx -= dx
          by -= dy
        }
        if room >= 2 {
          if o >= 0 {
            put_spot(tight, ntight, c, d as i32, room, against, 0)
            ntight += 1
          } else {
            put_spot(chain, nchain, c, d as i32, room, against, 0)
            nchain += 1
          }
        }
        continue
      }
      if mirrors > 0 {
        // the gap follows the bending way out; mirror cells in it stay passable
        let scope = mark()
        defer reset(scope)
        let start = begin()
        continue when !ray(x, y, dx, dy)
        let way = since(start).ptr
        let length = since(start).len as i32
        let run = 0
        while run < length && run <= pull && (grid[way[run]] == -1 || grid[way[run]] == mirror) {
          run += 1
        }
        if run > 0 && run <= pull && run < length && grid[way[run]] >= 0 {
          put_spot(gapped, ngapped, c, d as i32, 0, -1, run)
          ngapped += 1
        }
        continue
      }
      let gap = 0
      let nx = ax
      let ny = ay
      while gap <= pull && inside(nx, ny) && grid[ny * width + nx] == -1 {
        gap += 1
        nx += dx
        ny += dy
      }
      if gap > 0 && gap <= pull && inside(nx, ny) && grid[ny * width + nx] >= 0 {
        put_spot(gapped, ngapped, c, d as i32, 0, -1, gap)
        ngapped += 1
      }
    }
  }
  let t: []Spot = (tight, ntight as u32)
  let ch: []Spot = (chain, nchain as u32)
  let g: []Spot = (gapped, ngapped as u32)
  return Spots(t, ch, g)
}

// (A struct is written to memory and read back field by field: 0.2.1 miscompiles
// `list[k] = Spot(...)` and `let s = list[k]`.)
func put_spot(list: [*]mut Spot, k: i32, c: i32, di: i32, room: i32, against: i32, gap: i32) {
  list[k].c = c
  list[k].di = di
  list[k].room = room
  list[k].against = against
  list[k].gap = gap
}

func spot_at(list: []Spot, k: i32) -> Spot =>
  Spot(list.ptr[k].c, list.ptr[k].di, list.ptr[k].room, list.ptr[k].against, list.ptr[k].gap)

// Marks every rope the ropes in `blockers` (and `also`, unless -1) are waiting
// on, directly or down a chain.
func mark_below(blockers: []i32, also: i32) {
  let scope = mark()
  defer reset(scope)
  stamp += 1
  let stack = ints(blockers.len as i32 + 1 + n)
  let top = 0
  for z in blockers {
    stack[top] = z
    top += 1
    waits[z] = stamp
  }
  if also >= 0 {
    stack[top] = also
    top += 1
    waits[also] = stamp
  }
  while top > 0 {
    top -= 1
    for y in blk[stack[top]] {
      if waits[y] != stamp {
        waits[y] = stamp
        stack[top] = y
        top += 1
      }
    }
  }
}

// A cell is tied if a marked rope has its way out through it: a rope lying
// there would close a loop.
func tied(cell: i32) -> bool {
  for id in lanes[cell] {
    return true when waits[id] == stamp
  }
  return false
}

func any_tied(cells: []i32) -> bool {
  for c in cells {
    return true when tied(c)
  }
  return false
}

// Walks out a rope for a spot: its body behind the head, keeping off tied cells
// so that it closes no loop where it lies, and then, for a knot, k more cells
// of tail, which must reach a tied cell. A knot's first k + 2 cells run
// straight, so that it can start k cells back.
func walk(spot: Spot, k: i32) -> Walked {
  let back = (spot.di + 2) % 4
  let want = max(k + 2, len_lo + below(13, len_hi - len_lo + 1))
  let cells = ints(want)
  let tail = ints(k)
  let opts = ints(4)
  let ties = ints(4)
  cells[0] = spot.c
  let ncells = 1
  let ntail = 0
  let last = back
  let got = false
  grid[spot.c] = walked
  while ncells + ntail < want + k {
    let body = ncells < want
    let c = if !body && ntail > 0 { tail[ntail - 1] } else { cells[ncells - 1] }
    let x = c % width
    let y = c / width
    let open = 0
    for d in 4 {
      let nx = x + dir_x[d]
      let ny = y + dir_y[d]
      if inside(nx, ny) && grid[ny * width + nx] == -1 && (!body || !tied(ny * width + nx)) {
        opts[open] = d as i32
        open += 1
      }
    }
    break when open == 0
    let di = back
    if body {
      // the first step is straight back, and a knot's first k + 1 are
      if ncells <= k + 1 {
        break when !contains(span(opts, open), back)
      } elif contains(span(opts, open), last) && chance(14, straight) {
        di = last
      } else {
        di = opts[below(15, open)]
      }
    } else {
      // the tail of a knot heads for a tied cell if it has not found one yet
      let nties = 0
      if !got {
        for o in span(opts, open) {
          if tied((y + dy_of(o)) * width + x + dx_of(o)) {
            ties[nties] = o
            nties += 1
          }
        }
      }
      di = if nties > 0 { ties[below(16, nties)] } else { opts[below(17, open)] }
    }
    last = di
    let next = (y + dy_of(di)) * width + x + dx_of(di)
    grid[next] = walked
    if body {
      cells[ncells] = next
      ncells += 1
    } else {
      tail[ntail] = next
      ntail += 1
      if tied(next) {
        got = true
      }
    }
  }
  let w = Walked(true, span(cells, ncells), span(tail, ntail))
  for cell in w.cells {
    grid[cell] = -1
  }
  for cell in w.tail {
    grid[cell] = -1
  }
  return no_walk() when ncells < max(min_len, k + 2) || self_blocked(reversed(w.cells))
  if k > 0 {
    return no_walk() when ntail < k || !got || self_blocked(slid(w, k))
  }
  return w
}

// A knot's rope where it starts, k cells back from where it was walked: without
// the first k cells behind the head, and with the tail. From tail to head.
func slid(w: Walked, k: i32) -> []i32 {
  let start = begin()
  push_reversed(w.tail)
  push_reversed(part(w.cells.ptr, k, w.cells.len as i32))
  return since(start)
}

// A knot at a spot where there is something to stop against: shaped in the
// place it slides to, and starting k cells back.
func knot(spot: Spot) -> Cand {
  let lane = way_out(spot.c % width, spot.c / width, dx_of(spot.di), dy_of(spot.di))
  return no_cand() when !lane.ok
  mark_below(lane.ids, spot.against)
  return no_cand() when tied(spot.c)
  let k = 1 + below(18, min(pull, spot.room - 1))
  let w = walk(spot, k)
  return no_cand() when !w.ok
  let first = slid(w, k)
  let one = begin()
  push(k)
  let sum = trial(first, since(one), order_list())
  return no_cand() when sum < 0
  return Cand(true, first, no_lane(), sum - total0, bends_of(first), k, part(w.cells.ptr, 0, k), nothing())
}

// A trap at a spot with a gap ahead. Sliding it into the gap must leave ropes
// that can never get out, which is checked by doing it.
func trap(spot: Spot) -> Cand {
  let lane = way_out(spot.c % width, spot.c / width, dx_of(spot.di), dy_of(spot.di))
  return no_cand() when !lane.ok
  let gap = part(lane.cells.ptr, 0, spot.gap)
  mark_below(lane.ids, -1)
  return no_cand() when tied(spot.c) || !any_tied(gap)
  let w = walk(spot, 0)
  return no_cand() when !w.ok
  let path = reversed(w.cells)
  let sum = trial(path, nothing(), order_list())
  return no_cand() when sum < 0
  // (This leaves the board with the rope slid into the gap, and then dropped:
  // every replay sets the board up again first.)
  let id = add(path, nothing())
  set_up()
  place(id, spot.gap)
  let dead = relax()
  drop()
  return no_cand() when dead == 0
  return Cand(true, path, no_lane(), sum - total0, bends_of(path), 0, nothing(), gap)
}

// One try at a knot or a trap, in a scope of its own.
func spot_try(spots: Spots, is_knot: bool, budget: i32) -> Cand {
  let scope = mark()
  defer reset(scope)
  // a knot goes against another knot's resting place half the time, if there is one
  let list = if !is_knot { spots.gapped } elif spots.chain.len > 0 && (chance(20, 0.5) || spots.tight.len == 0) { spots.chain } else { spots.tight }
  return no_cand() when list.len == 0
  let spot = spot_at(list, below(21, list.len as i32))
  let c = if is_knot { knot(spot) } else { trap(spot) }
  return no_cand() when !fits(c, budget)
  return keep(c)
}

// While the level still wants knots or traps, try for one first, spreading them
// over the build. Places for them are scarce, so one that fits is taken.
// Whichever kind the level is shorter of gets the first tries.
func knot_or_trap(room: f64, budget: i32) -> Cand {
  let want_knots = tie - knots
  let want_traps = bait - traps
  return no_cand() when n < 2 || (want_knots <= 0 && want_traps <= 0)
  return no_cand() when !chance(19, 2 * (want_knots + want_traps) / room)
  let spots = knot_spots()
  let knot_first = want_knots > 0 && (want_traps <= 0 || knots <= traps)
  for half in 2 {
    let is_knot = knot_first == (half == 0)
    continue when (is_knot && want_knots <= 0) || (!is_knot && want_traps <= 0)
    for t in knot_tries {
      let c = spot_try(spots, is_knot, budget)
      return c when c.ok
    }
  }
  return no_cand()
}

// --- Laying ropes ------------------------------------------------------------------------------------

func reaches_idle_mirror(cells: []i32) -> bool {
  for c in cells {
    return true when slope[c] >= 0 && mirror_used[c] == 0
  }
  return false
}

// The best of a few ropes for this step: closest to the wanted gain, preferring
// long lanes when deep ropes are wanted, one that lands the score in its slot,
// and one that brings an idle mirror into play (while any lies on no rope's way
// out, one try per step aims at it).
func best_rope(budget: i32, desire: f64, need: i32) -> Cand {
  let row = if n == 0 { 0 } elif budget < 1 { 1 } elif desire >= 2.0 { 2 } elif desire >= 1.0 { 3 } else { 4 }
  let aim = mirrors > mirrors_used && n >= 1
  let best = no_cand()
  let best_miss = 1.0e300
  for k in tries_per_step {
    // each try in a scope of its own; the best so far is kept outside it
    let scope = mark()
    defer reset(scope)
    let kind = if aim && k == 0 { at_mirror } else { kinds.i32[row * 8 + k as i32] }
    let c = candidate(kind, -1)
    continue when !fits(c, budget)
    let lands = need > 0 && c.gain + c.bends >= need && covered + c.path.len as i32 >= min_coverage_slide * area
    let reaches = aim && reaches_idle_mirror(c.lane.cells)
    let long = if desire >= 2.0 { min(c.lane.free, 4) * 0.2 } else { 0.0 }
    let landing = if lands { 100.0 } else { 0.0 }
    let reaching = if reaches { 1.5 } else { 0.0 }
    let miss = abs(c.gain - desire) + rng(22, 0) * 0.6 - long - landing - reaching
    if miss < best_miss {
      best = keep(c)
      best_miss = miss
    }
  }
  return best
}

// The next rope, knot or trap to add, kept; not ok if none fits. A step, with
// a scope of its own.
func next_addition(score: i32) -> Cand {
  let scope = mark()
  defer reset(scope)
  let budget = s_max - score
  let room = max(1.0, (cover_goal - covered) / mean_len)
  survey()
  let c = knot_or_trap(room, budget)
  return c when c.ok
  return best_rope(budget, tap_depth, s_min - score)
}

func lay_ropes() {
  let stuck = 0
  for guard in 2 * area {
    let score = total0 + bend_sum
    break when score >= s_min && n >= min_ropes && covered >= cover_goal
    let best = next_addition(score)
    if !best.ok {
      stuck += 1
      break when stuck > max_stuck
      continue
    }
    stuck = 0
    commit(best)
  }
}

// One try at a rope through `cell`, in a scope of its own.
func gap_rope(cell: i32, budget: i32) -> Cand {
  let scope = mark()
  defer reset(scope)
  let c = candidate(if budget < 1 { plain } else { any }, cell)
  return no_cand() when !fits(c, budget)
  return keep(c)
}

// Packs the gaps: goes round the cells still empty, in a random order, and
// fits a rope into each that will take one. `empty` has room for every cell;
// it was allocated before the first rope, because ropes are committed here.
func pack_gaps(empty: [*]mut i32) {
  for sweep in 2 {
    let count = 0
    for cell in area {
      if grid[cell] == -1 {
        empty[count] = cell as i32
        count += 1
      }
    }
    let i = count - 1
    while i > 0 {
      let j = below(23, i + 1)
      let swap = empty[i]
      empty[i] = empty[j]
      empty[j] = swap
      i -= 1
    }
    for c in span(empty, count) {
      continue when grid[c] != -1
      let budget = s_max - total0 - bend_sum
      for t in 3 {
        let rope = gap_rope(c, budget)
        continue when !rope.ok
        commit(rope)
        break
      }
    }
  }
}

// --- The core -----------------------------------------------------------------------------------------

// The repeated-slide core, if the generator passed one: ropes with several
// stops each and the order to tap them in, as input words from `at`: per rope
// (len, cell x len, nStops, stop x nStops). False if it does not fit the board
// or does not play out.
func seed_core(at: i32, count: i32, plan: []i32, planned: bool) -> bool {
  return false when !core_fits(at, count)
  let j = at
  for r in count {
    let l = word(j)
    let ns = word(j + 1 + l)
    add(words(j + 1, l), words(j + 2 + l, ns))
    covered += l
    j += 2 + l + ns
  }
  settled = mark()
  if planned {
    copy_to(order, plan)
    norder = plan.len as i32
  } else {
    for i in n {
      order[i] = i as i32
    }
    norder = n
  }
  return false when !replay(order_list(), -1)
  total0 = cost_sum
  for rope in n {
    let id = rope as i32
    bend_sum += bends_of(path_of(id))
    if stops[id].len > 0 {
      knots += 1
    }
    for c in path_of(id) {
      grid[c] = id
    }
    // the cells each stop will bring it onto, still empty, are resting places
    for offset in stops[id] {
      for c in part(seq[id].ptr, len[id], len[id] + offset) {
        if grid[c] == -1 {
          rest[c] = id
        }
      }
    }
  }
  note_order()
  return true
}

// Each core rope has two cells or more, lies on the board and crosses no other.
func core_fits(at: i32, count: i32) -> bool {
  let scope = mark()
  defer reset(scope)
  let taken = ints_of(area, 0)
  let j = at
  for r in count {
    let l = word(j)
    return false when l < 2
    for c in words(j + 1, l) {
      return false when c < 0 || c >= area || taken[c] == 1
      taken[c] = 1
    }
    j += 2 + l + word(j + 1 + l)
  }
  return true
}

// --- The finished level ----------------------------------------------------------------------------------

// Checks and measures the woven board (the last replay must have emptied it)
// and writes it out. Returns 0, writing nothing, if it is too sparse or too
// loose. The board is never trimmed or turned: keepBounds is always set.
func finished() -> i32 {
  let scope = mark()
  defer reset(scope)
  let cells = 0
  let blocked = 0
  for i in n {
    cells += len[i]
    if cost[i] > 0 {
      blocked += 1
    }
  }
  // Enough rope on the board and, beyond the narrowest boards, at least half
  // the ropes blocked. (Divide, then compare, as the JS does.)
  let filled = f64(cells) / f64(width * height)
  let share = f64(blocked) / f64(n)
  if width <= small_w {
    return 0 when filled < min_coverage_small
  } elif filled < min_coverage_slide || share < min_blocked_share {
    return 0
  }
  // cannot happen; but never hand out a level without its solution
  return 0 when !plays_out(span(taps, ntaps))
  // Count the knots that really are one (a rope meant to slide that starts in a
  // loop), and the slides open at the start that would leave ropes that can
  // never get out.
  set_up()
  let looped = ints_of(n, 0)
  find_loops(looped)
  let tied_up = 0
  let fatal = 0
  for rope in n {
    let id = rope as i32
    if stops[id].len > 0 && looped[id] == 1 {
      tied_up += 1
    }
    let to = slide_to(id)
    if to > 0 {
      place(id, to)
      if relax() > 0 {
        fatal += 1
      }
      place(id, 0)
    }
  }
  let out = outbuf as [*]mut i32
  out[0] = 1
  out[1] = tied_up
  out[2] = fatal
  out[3] = n
  let k = 4
  for i in n {
    out[k] = len[i]
    k += 1
    for c in path_of(i as i32) {
      out[k] = c
      k += 1
    }
  }
  out[k] = ntaps
  k += 1
  for t in span(taps, ntaps) {
    out[k] = t
    k += 1
  }
  return 1
}

// --- Entry point --------------------------------------------------------------------------------------------

// An empty board and a build that has not begun, in the caller's scope: every
// global above is set here or in new_board, so that nothing is left over from
// the call before. `core_stops` is how many stops the core's ropes have between
// them and `plan_len` the length of its plan; the rope lengths and `pull` must
// be set already.
func start_build(w: i32, h: i32, core_stops: i32, plan_len: i32) {
  // Ropes have two cells or more, so there are at most area / 2 of them, and
  // one being tried. Each is tapped once to leave, and once per stop: a knot
  // has one stop, a core rope has what the input gives it.
  new_board(w, h, w * h + 2 + core_stops)
  // The result is at most 4 words, a length and the cells per rope, and a
  // length and the taps: it must fit outbuf's 16,384 words.
  assert area * 5 / 2 + 8 + core_stops <= 16384
  grid = ints_of(area, -1)
  rest = ints_of(area, -1)
  mirror_used = ints_of(area, 0)
  mirrors_used = 0
  order = ints(max(area, plan_len))
  norder = 0
  total0 = 0
  bend_sum = 0
  covered = 0
  knots = 0
  traps = 0
  up = ints_of(area, 0)
  waits = ints_of(area + 1, 0)
  stamp = 0
  // The longest rope a candidate can have: a walk wants at most
  // max(len_hi, pull + 2) cells.
  path_room = max(len_hi, pull + 2)
  kept_path = ints(path_room)
  kept_rest = ints(pull)
  kept_gap = ints(pull)
  settled = mark()
}

// Builds one board from the input. Returns output word 0: 1 if a board was
// written, 0 if weave gives up (null in the JS).
export func weave() -> i32 {
  // Everything below lives until this call returns, by whichever return.
  let call = mark()
  defer reset(call)
  outbuf.i32[0] = 0

  seed(inbuf.u32[0])
  let w = word(1)
  let h = word(2)
  len_lo = word(3)
  len_hi = word(4)
  min_len = word(5)
  tie = word(6)
  bait = word(7)
  pull = word(8)
  // words 9 and 10 are ropeCount (never set) and keepBounds (always set)
  straight = finbuf.f64[0]
  let cover = finbuf.f64[1]
  tap_depth = finbuf.f64[2]
  mean_len = (len_lo + len_hi) / 2.0 * 0.85
  cover_goal = cover * (w * h)

  // The core and the plan lie behind the mirrors: find them first, because
  // they decide how large some tables are.
  let nmirrors = word(11)
  let core_at = 12 + 2 * nmirrors
  let ncore = word(core_at)
  let core_stops = 0
  let j = core_at + 1
  for r in ncore {
    let l = word(j)
    let ns = word(j + 1 + l)
    core_stops += ns
    j += 2 + l + ns
  }
  let planned = word(j) >= 0
  let plan = if planned { words(j + 1, word(j)) } else { nothing() }

  start_build(w, h, core_stops, plan.len as i32)
  for m in nmirrors {
    let pair = 12 + 2 * m as i32
    add_mirror(word(pair), word(pair + 1))
  }
  for c in span(mirror_at, mirrors) {
    grid[c] = mirror
  }
  // pack_gaps's list of cells, taken here because ropes are committed while
  // it is in use.
  let spare = ints(area)
  settled = mark()

  if ncore > 0 {
    return 0 when !seed_core(core_at + 1, ncore, plan, planned)
  }
  lay_ropes()
  pack_gaps(spare)
  return 0 when n < min_ropes || !replay(order_list(), -1)
  return finished()
}

// --- Tests ------------------------------------------------------------------------------------------------------

// A 4 x 4 board, cells 0..3 over 4..7 over 8..11 over 12..15, with no ropes on
// it yet.
func test_board() {
  len_lo = 3
  len_hi = 5
  min_len = 2
  pull = 3
  start_build(4, 4, 0, 0)
}

func list3(a: i32, b: i32, c: i32) -> []i32 {
  let start = begin()
  push(a)
  push(b)
  push(c)
  return since(start)
}

test "bends are counted along a path" {
  let scope = mark()
  defer reset(scope)
  test_board()
  assert bends_of(list3(0, 1, 2)) == 0
  assert bends_of(list3(0, 1, 5)) == 1
  let zigzag = begin()
  push(0)
  push(4)
  push(5)
  push(9)
  push(13)
  assert bends_of(since(zigzag)) == 2
}

test "a way out lists its cells, the empty ones and the ropes in it" {
  let scope = mark()
  defer reset(scope)
  test_board()
  grid[6] = 0       // rope 0 on (2, 1)
  grid[7] = held    // a cell kept empty for a trap: neither free nor a rope
  let lane = way_out(0, 1, 1, 0)
  assert lane.ok
  assert lane.cells.len == 3
  assert lane.cells.ptr[0] == 5
  assert lane.free == 1
  assert lane.ids.len == 1
  assert lane.ids.ptr[0] == 0
}

test "a grown rope stays on the board and leaves the grid as it was" {
  let scope = mark()
  defer reset(scope)
  test_board()
  seed(7)
  let cells = grow(5, 1, 0.5)   // from (1, 1), first step +y
  assert cells.len >= 2 && cells.len <= 5
  assert cells.ptr[0] == 5
  assert cells.ptr[1] == 9
  assert draw_count() >= 1
  for c in span(grid, 16) {
    assert c == -1
  }
}

test "knot_spots finds heads against a rope, and heads a gap away from one" {
  let scope = mark()
  defer reset(scope)
  test_board()
  grid[3] = 0       // rope 0 on (3, 0)
  let spots = knot_spots()
  // straight room of two cells behind: (2, 0) pointing +x, (3, 1) pointing -y
  assert spots.tight.len == 2
  let a = spot_at(spots.tight, 0)
  assert a.c == 2 && a.di == 0 && a.room == 2 && a.against == -1
  let b = spot_at(spots.tight, 1)
  assert b.c == 7 && b.di == 3 && b.room == 2
  assert spots.chain.len == 0
  // a gap of one or two cells ahead: from (0, 0) and (1, 0), from (3, 2) and (3, 3)
  assert spots.gapped.len == 4
  let g = spot_at(spots.gapped, 0)
  assert g.c == 0 && g.di == 0 && g.gap == 2
  let last = spot_at(spots.gapped, 3)
  assert last.c == 15 && last.di == 3 && last.gap == 2
  // where a knot will come to rest counts as something to stop against
  rest[11] = 5
  let again = knot_spots()
  assert again.chain.len == 1
}

// Case 162 of weave-expected.json: a 4 x 4 board, seed 1776415523, medium ropes.
data case_in = [1776415523, 4, 4, 4, 8, 2, 9, 9, 3, 0, 1, 0, 0, -1]
data case_out = [1, 0, 0, 4, 8, 3, 7, 6, 5, 9, 13, 12, 8, 2, 4, 0, 4, 11, 15, 14, 10, 2, 1, 2, 4, 1, 0, 3, 2]

test "weave gives the board the JS gives" {
  for i, v in case_in {
    inbuf.i32[i] = v
  }
  finbuf.f64[0] = 0.35
  finbuf.f64[1] = 0.99
  finbuf.f64[2] = 6.24
  let before = mark()
  assert weave() == 1
  assert mark() == before
  for j, v in case_out {
    assert outbuf.i32[j] == v
  }
  assert draws() == 231
}
