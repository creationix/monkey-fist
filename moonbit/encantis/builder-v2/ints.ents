// Lists of i32 on the bump stack (lib/stack.ents). Everything the builder
// keeps in lists is an i32: cells (y * W + x), rope ids, directions. So one set
// of helpers serves every list, and a list travels as a slice, []i32.
//
// A list whose length is not known in advance is built in place at the top of
// the stack:
//
//   let start = begin()
//   push(a)  push(b)  ...
//   let list = since(start)
//
// Nothing else may be allocated between begin and since: the pushes must stay
// contiguous. Two lists that grow in turns cannot both be built this way; give
// all but one a known capacity with ints(n) and fill it by index.
//
// Nothing here frees: a list lives until the scope it was built in resets.

import "./lib/stack" (
  "mark" func mark() -> u32
  "alloc" func alloc(n: u32) -> u32
  "extend" func extend(n: u32) -> u32
)

// Room for n ints, not zeroed.
export func ints(n: i32) -> [*]mut i32 => alloc((n as u32) * 4) as [*]mut i32

// Room for n ints, each set to v.
export func ints_of(n: i32, v: i32) -> [*]mut i32 {
  let p = alloc((n as u32) * 4) as [*]mut i32
  p[0..n as u32] = v
  return p
}

export func fill(p: [*]mut i32, n: i32, v: i32) {
  p[0..n as u32] = v
}

// The first n ints at p, as a list.
export func span(p: [*]i32, n: i32) -> []i32 => (p, n as u32)

// Elements from..to (to not included) of the array at p, as a list.
export func part(p: [*]i32, from: i32, to: i32) -> []i32 => p[from as u32..to as u32]

// The empty list.
export func nothing() -> []i32 => (0 as [*]i32, 0:u32)

export func begin() -> u32 => alloc(0)

export func push(v: i32) {
  let p = extend(4) as [*]mut i32
  p[0] = v
}

export func push_all(xs: []i32) {
  for x in xs {
    push(x)
  }
}

// Pushes xs last element first.
export func push_reversed(xs: []i32) {
  let i = xs.len
  while i > 0 {
    i -= 1
    push(xs.ptr[i])
  }
}

// Everything pushed since `start`.
export func since(start: u32) -> []i32 => (start as [*]i32, (mark() - start) / 4)

export func contains(xs: []i32, v: i32) -> bool {
  for x in xs {
    return true when x == v
  }
  return false
}

// A copy of xs in reverse order, at the top of the stack.
export func reversed(xs: []i32) -> []i32 {
  let start = begin()
  push_reversed(xs)
  return since(start)
}

// Copies xs to dst, which must have room for it.
export func copy_to(dst: [*]mut i32, xs: []i32) {
  for i, x in xs {
    dst[i] = x
  }
}

test "a list is built in place and read back as a slice" {
  let start = begin()
  push(7)
  push(-2)
  push(9)
  let list = since(start)
  assert list.len == 3
  assert contains(list, -2)
  assert !contains(list, 8)
  let back = reversed(list)
  assert back.len == 3
  assert back.ptr[0] == 9
  assert back.ptr[2] == 7
  let room = ints_of(4, -1)
  assert room[3] == -1
  copy_to(room, list)
  assert room[0] == 7
  assert room[2] == 9
  assert span(room, 2).len == 2
  let mid = part(room, 1, 3)
  assert mid.len == 2
  assert mid.ptr[0] == -2
  assert nothing().len == 0
}
