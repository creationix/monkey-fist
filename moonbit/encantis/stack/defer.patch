+  for (let f = frames.length - 1; f >= Math.max(0, frames.length - count); f--) {
+    for (let d = frames[f].defers.length - 1; d >= 0; d--) out.push(discardedExprToWat(frames[f].defers[d], ctx))
+  }
+  return out.join('\n')
