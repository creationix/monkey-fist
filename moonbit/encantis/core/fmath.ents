// Math.pow and Number(x.toFixed(d)), computed in the module, so that the core
// has no imports (six loaders instantiate it with {}).
//
// pow is fdlibm's e_pow.c, ported line for line from MoonBit's core library
// (/root/.moon/lib/core/math/pow_double_nonjs.mbt, moon 0.1.20261104), with the
// three changes V8 made to it (src/base/ieee754.cc, V8 12.4, node 22), so that it
// is Math.pow bit for bit:
// - pow(1, NaN) and pow(+-1, +-Infinity) are NaN, as the JS says, not 1;
// - the last step is r = z*t1 / ((t1-2) - (w+z*w)), where fdlibm (and so
//   MoonBit's @math.pow) has r = z*t1/(t1-2) - (w+z*w). That moves the last bit
//   of about 3% of results: of 0.01..100 in steps of 0.01, raised to 1.3, 420
//   of 10,001; 5 of the 120 Journey difficulties. So the MoonBit wasm-gc build's
//   target_challenge is one ulp off the JS's there (the oracle shows it).
//
// ====================================================
// Copyright (C) 1993 by Sun Microsystems, Inc. All rights reserved.
//
// Developed at SunPro, a Sun Microsystems, Inc. business.
// Permission to use, copy, modify, and distribute this
// software is freely granted, provided that this notice
// is preserved.
// ====================================================

// The words of an f64, through a scratch cell (there is no reinterpret).
data scratch = mut [0:u8; 8]

func high(x: f64) -> u32 {
  scratch.f64[0] = x
  return scratch.u32[1]
}

func low(x: f64) -> u32 {
  scratch.f64[0] = x
  return scratch.u32[0]
}

func of_words(hi: u32, lo: u32) -> f64 {
  scratch.u32[0] = lo
  scratch.u32[1] = hi
  return scratch.f64[0]
}

func with_low(x: f64, lo: u32) -> f64 => of_words(high(x), lo)
func with_high(x: f64, hi: u32) -> f64 => of_words(hi, low(x))

def two53 = 9007199254740992.0
def huge = 1.0e300
def tiny = 1.0e-300

// poly coefs for (3/2)*(log(x)-2s-2/3*s**3
def l1 = 5.99999999999994648725e-01
def l2 = 4.28571428578550184252e-01
def l3 = 3.33333329818377432918e-01
def l4 = 2.72728123808534006489e-01
def l5 = 2.30660745775561754067e-01
def l6 = 2.06975017800338417784e-01
def p1 = 1.66666666666666019037e-01
def p2 = -2.77777777770155933842e-03
def p3 = 6.61375632143793436117e-05
def p4 = -1.65339022054652515390e-06
def p5 = 4.13813679705723846039e-08
def lg2 = 6.93147180559945286227e-01
def lg2_h = 6.93147182464599609375e-01
def lg2_l = -1.90465429995776804525e-09
def ovt = 8.0085662595372944372e-17       // -(1024-log2(ovfl+.5ulp))
def cp = 9.61796693925975554329e-01       // 2/(3ln2)
def cp_h = 9.61796700954437255859e-01
def cp_l = -7.02846165095275826516e-09
def ivln2 = 1.44269504088896338700e+00    // 1/ln2
def ivln2_h = 1.44269502162933349609e+00
def ivln2_l = 1.92596299112661746887e-08
// bp, dp_h and dp_l of e_pow.c, indexed by k (0 or 1)
def bp1 = 1.5
def dp_h1 = 5.84962487220764160156e-01
def dp_l1 = 1.35003920212974897128e-08

// x * 2^n, as scalbn.mbt computes it.
func scalbn(x: f64, e: i32) -> f64 {
  let n = e
  let y = x
  if n > 1023 {
    y *= 8.98846567431158e307                       // 0x1.0p1023
    n -= 1023
    if n > 1023 {
      y *= 8.98846567431158e307
      n -= 1023
      if n > 1023 {
        n = 1023
      }
    }
  } elif n < -1022 {
    // make sure final n < -53 to avoid double rounding in the subnormal range
    y *= 2.2250738585072014e-308 * 9007199254740992.0   // 0x1.0p-1022 * 0x1.0p53
    n += 1022 - 53
    if n < -1022 {
      y *= 2.2250738585072014e-308 * 9007199254740992.0
      n += 1022 - 53
      if n < -1022 {
        n = -1022
      }
    }
  }
  return y * of_words(((0x3ff + n) as u32) << 20, 0)
}

// Math.pow(x, y)
export func pow(x: f64, y: f64) -> f64 {
  let z: f64 = 0
  let ax: f64 = 0
  let z_h: f64 = 0
  let z_l: f64 = 0
  let p_h: f64 = 0
  let p_l: f64 = 0
  let y1: f64 = 0
  let t1: f64 = 0
  let t2: f64 = 0
  let r: f64 = 0
  let s: f64 = 0
  let t: f64 = 0
  let u: f64 = 0
  let v: f64 = 0
  let w: f64 = 0
  let i: i32 = 0
  let j: i32 = 0
  let k: i32 = 0
  let yisint: i32 = 0
  let n: i32 = 0
  let hx = high(x) as i32
  let lx = low(x)
  let hy = high(y) as i32
  let ly = low(y)
  let ix = hx & 0x7fffffff
  let iy = hy & 0x7fffffff
  // y==zero: x**0 = 1
  return 1.0 when ((iy as u32) | ly) == 0
  // +-NaN return x+y
  if ix > 0x7ff00000 || (ix == 0x7ff00000 && lx != 0) || iy > 0x7ff00000 || (iy == 0x7ff00000 && ly != 0) {
    return x + y
  }
  // determine if y is an odd int when x < 0
  // yisint = 0 ... y is not an integer
  // yisint = 1 ... y is an odd int
  // yisint = 2 ... y is an even int
  if hx < 0 {
    if iy >= 0x43400000 {
      yisint = 2
    } elif iy >= 0x3ff00000 {
      k = (iy >> 20) - 0x3ff
      if k > 20 {
        let jl = ly >> (52 - k)
        if jl << (52 - k) == ly {
          yisint = 2 - ((jl & 1) as i32)
        }
      } elif ly == 0 {
        j = iy >> (20 - k)
        if j << (20 - k) == iy {
          yisint = 2 - (j & 1)
        }
      }
    }
  }
  // special value of y
  if ly == 0 {
    if iy == 0x7ff00000 {
      // y is +-inf: (+-1)**+-inf is NaN (V8); (|x|>1)**+-inf = inf,0; (|x|<1)**-,+inf = inf,0
      return y - y when ((ix - 0x3ff00000) | (lx as i32)) == 0
      return if hy >= 0 { y } else { 0.0 } when ix >= 0x3ff00000
      return if hy < 0 { -y } else { 0.0 }
    }
    if iy == 0x3ff00000 {
      // y is +-1
      return 1.0 / x when hy < 0
      return x
    }
    return x * x when hy == 0x40000000          // y is 2
    if hy == 0x3fe00000 {
      return sqrt(x) when hx >= 0               // y is 0.5, x >= +0
    }
  }
  ax = abs(x)
  // special value of x
  if lx == 0 {
    if ix == 0x7ff00000 || ix == 0 || ix == 0x3ff00000 {
      z = ax                                    // x is +-0,+-inf,+-1
      if hy < 0 {
        z = 1.0 / z                             // z = (1/|x|)
      }
      if hx < 0 {
        if ((ix - 0x3ff00000) | yisint) == 0 {
          z = of_words(0x7ff80000, 0)           // (-1)**non-int is NaN
        } elif yisint == 1 {
          z = -z                                // (x<0)**odd = -(|x|**odd)
        }
      }
      return z
    }
  }
  n = (hx >> 31) + 1
  // (x<0)**(non-int) is NaN
  return of_words(0x7ff80000, 0) when (n | yisint) == 0
  s = 1.0                                       // s (sign of result -ve**odd) = -1 else = 1
  if (n | (yisint - 1)) == 0 {
    s = -1.0                                    // (-ve)**(odd int)
  }
  if iy > 0x41e00000 {
    // |y| is huge: |y| > 2**31
    if iy > 0x43f00000 {
      // |y| > 2**64, must o/uflow
      return if hy < 0 { huge * huge } else { tiny * tiny } when ix <= 0x3fefffff
      return if hy > 0 { huge * huge } else { tiny * tiny } when ix >= 0x3ff00000
    }
    // over/underflow if x is not close to one
    return if hy < 0 { s * huge * huge } else { s * tiny * tiny } when ix < 0x3fefffff
    return if hy > 0 { s * huge * huge } else { s * tiny * tiny } when ix > 0x3ff00000
    // now |1-x| is tiny <= 2**-20, suffice to compute log(x) by x-x^2/2+x^3/3-x^4/4
    t = ax - 1.0                                // t has 20 trailing zeros
    w = t * t * (0.5 - t * (0.3333333333333333333333 - t * 0.25))
    u = ivln2_h * t                             // ivln2_h has 21 sig. bits
    v = t * ivln2_l - w * ivln2
    t1 = u + v
    t1 = with_low(t1, 0)
    t2 = v - (t1 - u)
  } else {
    n = 0
    // take care subnormal number
    if ix < 0x00100000 {
      ax *= two53
      n -= 53
      ix = high(ax) as i32
    }
    n += (ix >> 20) - 0x3ff
    j = ix & 0x000fffff
    // determine interval
    ix = j | 0x3ff00000                         // normalize ix
    if j <= 0x3988E {
      k = 0                                     // |x|<sqrt(3/2)
    } elif j < 0xBB67A {
      k = 1                                     // |x|<sqrt(3)
    } else {
      k = 0
      n += 1
      ix -= 0x00100000
    }
    ax = with_high(ax, ix as u32)
    let bp = if k == 1 { bp1 } else { 1.0 }
    let dp_h = if k == 1 { dp_h1 } else { 0.0 }
    let dp_l = if k == 1 { dp_l1 } else { 0.0 }
    // compute ss = s_h+s_l = (x-1)/(x+1) or (x-1.5)/(x+1.5)
    u = ax - bp                                 // bp[0]=1.0, bp[1]=1.5
    v = 1.0 / (ax + bp)
    let ss = u * v
    let s_h = with_low(ss, 0)
    // t_h=ax+bp[k] High
    let t_h = of_words((((ix as u32) >> 1) | 0x20000000) + 0x00080000 + ((k as u32) << 18), 0)
    let t_l = ax - (t_h - bp)
    let s_l = v * (u - s_h * t_h - s_h * t_l)
    // compute log(ax)
    let s2 = ss * ss
    r = s2 * s2 * (l1 + s2 * (l2 + s2 * (l3 + s2 * (l4 + s2 * (l5 + s2 * l6)))))
    r += s_l * (s_h + ss)
    s2 = s_h * s_h
    t_h = 3.0 + s2 + r
    t_h = with_low(t_h, 0)
    t_l = r - (t_h - 3.0 - s2)
    // u+v = ss*(1+...)
    u = s_h * t_h
    v = s_l * t_h + t_l * ss
    // 2/(3log2)*(ss+...)
    p_h = u + v
    p_h = with_low(p_h, 0)
    p_l = v - (p_h - u)
    z_h = cp_h * p_h                            // cp_h+cp_l = 2/(3*log2)
    z_l = cp_l * p_h + p_l * cp + dp_l
    // log2(ax) = (ss+..)*2/(3*log2) = n + dp_h + z_h + z_l
    t = f64(n)
    t1 = z_h + z_l + dp_h + t
    t1 = with_low(t1, 0)
    t2 = z_l - (t1 - t - dp_h - z_h)
  }
  // split up y into y1+y2 and compute (y1+y2)*(t1+t2)
  y1 = with_low(y, 0)
  p_l = (y - y1) * t1 + y * t2
  p_h = y1 * t1
  z = p_l + p_h
  j = high(z) as i32
  i = low(z) as i32
  if j >= 0x40900000 {
    // z >= 1024
    return s * huge * huge when ((j - 0x40900000) | i) != 0      // overflow
    return s * huge * huge when p_l + ovt > z - p_h               // overflow
  } elif (j & 0x7fffffff) >= 0x4090cc00 {
    // z <= -1075
    return s * tiny * tiny when (((j as u32) - 0xc090cc00) | (i as u32)) != 0   // underflow
    return s * tiny * tiny when p_l <= z - p_h                                     // underflow
  }
  // compute 2**(p_h+p_l)
  i = j & 0x7fffffff
  k = (i >> 20) - 0x3ff
  n = 0
  if i > 0x3fe00000 {
    // if |z| > 0.5, set n = [z+0.5]
    n = j + (0x00100000 >> (k + 1))
    k = ((n & 0x7fffffff) >> 20) - 0x3ff        // new k for n
    t = of_words((n & ~(0x000fffff >> k)) as u32, 0)
    n = ((n & 0x000fffff) | 0x00100000) >> (20 - k)
    if j < 0 {
      n = -n
    }
    p_h -= t
  }
  t = p_l + p_h
  t = with_low(t, 0)
  u = t * lg2_h
  v = (p_l - (t - p_h)) * lg2 + t * lg2_l
  z = u + v
  w = v - (z - u)
  t = z * z
  t1 = z - t * (p1 + t * (p2 + t * (p3 + t * (p4 + t * p5))))
  r = z * t1 / ((t1 - 2.0) - (w + z * w))      // V8's; fdlibm: z * t1 / (t1 - 2.0) - (w + z * w)
  z = 1.0 - (r - z)
  j = high(z) as i32
  j += ((n as u32) << 20) as i32
  if j >> 20 <= 0 {
    z = scalbn(z, n)
  } else {
    // subnormal output
    z = with_high(z, high(z) + ((n as u32) << 20))
  }
  return s * z
}

// Number(x.toFixed(digits)), for digits up to 8: the nearest number with that
// many decimals to x as it is (the larger on a tie), the decimal read back.
//
// metrics.mbt's to_fixed scales and rounds: round(x * 10^d) / 10^d. The product
// is rounded, so a tie is found where x lies just under it: 0.01875 (3/160) is
// 0.0187499999999999993 and toFixed(4) gives 0.0187, scale-and-round 0.0188.
// Here the product is exact, x * 10^d = p + e (Dekker's two-product), and the
// half is decided on it.
export func to_fixed(x: f64, digits: u32) -> f64 {
  return x when !(abs(x) < 1.0e21)              // NaN, infinities, and what toFixed writes in exponent form
  return 0.0 when x == 0.0                       // -0 too: (-0).toFixed(4) is "0.0000"
  return -to_fixed(-x, digits) when x < 0.0      // rounds half away from zero; -0.00001 gives -0
  let scale: f64 = 1.0
  for i in digits {
    scale *= 10.0
  }
  let p = x * scale
  // From 2^53 up, f + 1 and n / scale round twice (67215938362.95128 to 7 decimals gave
  // ...95129). There x * 10^d has no fraction a double can show, and the decimals read
  // back as x itself: Number(x.toFixed(d)) is x (found by G1's review; check-g1-wide.cjs).
  return x when p >= 9007199254740992.0
  // e = x * scale - p, exactly
  let c = 134217729.0 * x                       // 2^27 + 1
  let xh = c - (c - x)
  let xl = x - xh
  let d = 134217729.0 * scale
  let sh = d - (d - scale)
  let sl = scale - sh
  let e = ((xh * sh - p) + xh * sl + xl * sh) + xl * sl
  let f = floor(p)
  // p - f is exact; the value is f + (p - f) + e, and e is far smaller than a half
  let n = if (p - f - 0.5) + e >= 0.0 { f + 1.0 } else { f }
  return n / scale
}

// --- Tests ---

test "pow gives V8's Math.pow on the generator's inputs" {
  // random_test.mbt's values, from V8
  assert pow(0.205, 1.3) == 0.1274324460373689
  assert 300.0 * pow(0.5, 1.3) == 121.83785945343531
  assert pow(2.0, 10.0) == 1024.0
  assert pow(2.0, 0.5) == 1.4142135623730951
  assert pow(-2.0, 3.0) == -8.0
  assert pow(0.0, 0.0) == 1.0
  assert pow(10.0, -2.0) == 0.01
}

test "to_fixed is Number(x.toFixed(d))" {
  assert to_fixed(1.23456, 4) == 1.2346
  assert to_fixed(2.71828, 4) == 2.7183
  assert to_fixed(0.01875, 4) == 0.0187
  assert to_fixed(0.00005, 4) == 0.0001
  assert to_fixed(0.6, 4) == 0.6
  assert to_fixed(0.12345, 3) == 0.123
}
