// Copied from lib/stack.ents of Encantis (github.com/creationix/encantis) at commit
// cb3fc4f3514fc834b4fb6c3e2ea5fcfd11a720da (origin/main 03225bc has the same tree).
// Changed for the Monkey Fist core: the stack is 16 MiB, not 256 KiB (capacity
// and space), and it gains clear() (back to the base, for each export call, so a
// trap in an earlier call never leaves the stack unusable) and peak() (the
// highest top reached since the last clear, one compare per alloc).
//
// A bump stack in linear memory: the allocator the containers of this
// directory use. Every allocation is a pointer bump and nothing is freed one
// by one. A scope frees everything it allocated by resetting to a mark, and
// defer ties that to every way out of the scope:
//
//   let scope = mark()
//   defer reset(scope)
//
// Scopes nest. A result that must outlive a scope is allocated before
// entering it. Marks are addresses. alloc starts each allocation 8-byte
// aligned; extend grows the topmost allocation by exactly n bytes, which is
// how a Vec at the top of the stack grows in place.
//
// comptime-n: with comptime value parameters this file would be Stack(n), and
// the core would take its size (and a second arena) without copying the file.

def capacity = 16777216:u32
data space = mut [0:u8; 16777216]
global top: u32 = 0
global high: u32 = 0

// The current top, as an address.
export func mark() -> u32 => (space as u32) + top

// Frees everything allocated since the mark m was taken.
export func reset(m: u32) {
  top = m - (space as u32)
}

// Frees everything: the stack is empty again, and the peak starts over.
export func clear() {
  top = 0
  high = 0
}

// The most bytes the stack has held since the last clear.
export func peak() -> u32 => max(high, top)

// n bytes, 8-byte aligned. Traps when the stack is full.
export func alloc(n: u32) -> (p: u32) {
  top = (top + 7) & 0xFFFFFFF8
  p = (space as u32) + top
  top += n
  assert top <= capacity
  if top > high {
    high = top
  }
}

// n more bytes at the top, directly after what is there (no alignment).
export func extend(n: u32) -> (p: u32) {
  p = (space as u32) + top
  top += n
  assert top <= capacity
  if top > high {
    high = top
  }
}

// n bytes, all zero.
export func zeroed(n: u32) -> (p: u32) {
  p = alloc(n)
  let bytes = p as [*]mut u8
  bytes[0..n] = 0
}

test "a scope frees what it allocates, on every way out" {
  let base = mark()
  let a = alloc(10)
  assert a == base
  assert mark() == base + 10
  let inner = mark()
  let b = zeroed(4)
  assert b == a + 16
  reset(inner)
  assert mark() == base + 10
  reset(base)
  assert mark() == base
}

test "extend builds a contiguous array from a mark" {
  let base = mark()
  let start = mark()
  for i in 5 {
    let w = extend(4) as [*]mut u32
    w[0] = i * 10
  }
  let words = start as [*]u32
  assert words[0] == 0
  assert words[4] == 40
  assert mark() == start + 20
  reset(base)
}

test "zeroed memory reads as zero after other use" {
  let base = mark()
  let used = alloc(8) as [*]mut u32
  used[0] = 7
  used[1] = 9
  reset(base)
  let fresh = zeroed(8) as [*]u32
  assert fresh[0] == 0
  assert fresh[1] == 0
  reset(base)
}

test "clear empties the stack, and peak is the most it held" {
  clear()
  let base = mark()
  alloc(100)
  let inner = mark()
  alloc(1000)
  reset(inner)
  assert peak() == 1104
  clear()
  assert mark() == base
  assert peak() == 0
  alloc(8)
  assert peak() == 8
  clear()
}
