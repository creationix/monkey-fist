// square.mbt of the MoonBit core without weave's own part: the compact offset kernels
// of levels.js at 9e69e3a, for square boards without spinners. A rope can only occupy
// cells of its own track (its body, then its way out as fixed mirrors bend it), so a
// board is one offset per rope. (sq_play, bends_of, sq_blockers, groups_of and
// sq_looped serve only the woven builder, which has its own: weave-board.ents.)
//
// A board is a SqBoard behind a *mut, made on the stack by sq_board: several are alive
// at once (the generator holds one while casual play makes others). Its tables are
// many-pointers, so indexing them is not checked: every cell index comes from a track,
// and every rope index from 0..n or a plan the caller checked. Hot reads carry
// `// unchecked:`.
//
// A search keeps what its JS closure captured in a context struct behind a *mut (Solve,
// Fewest), and is a top-level recursive function over it (`// closure:`). Each search
// node takes a scope for its list of tries, freed on return (defer). What outlives a
// node, the moves found and the positions seen, is made before the search with all its
// room (`// reserve:`): a Vec that grew inside a node would move into the node's room
// and be freed with it. The positions seen are keys.ents sets keyed by the offsets
// themselves (MoonBit's key_of(off) strings).
//
// Lifetimes. A function that returns a list builds it in its caller's scope:
// sq_board, sq_tracks, sq_frozen, sq_replay and b.paths leave the board there too; sq_solve,
// sq_fewest_player_taps and sq_postpone_exits make their result there and do the
// rest in a scope of their own. Functions that return a number leave nothing.
//
// Options: sq_board, sq_fewest_player_taps return ?*T, sq_tracks and sq_postpone_exits
// ?[]T, and sq_player_taps returns -1 for none (`// enum:`). Solved.solved is the tri-state
// solved_yes, solved_no, solved_unknown (MoonBit's Bool?), and events are ev_exit,
// ev_bounce, ev_slide.

import "./lib/stack" (
  "mark" func mark() -> u32
  "reset" func reset(m: u32)
  "alloc" func alloc(n: u32) -> u32
)
import "./lib/vec" (
  "Vec" func Vec(comptime T: type) -> type
  "vec" func vec(comptime T: type, cap: u32) -> *mut Vec(T)
  "push" func push(comptime T: type, v: *mut Vec(T), x: T)
  "pop" func pop(comptime T: type, v: *mut Vec(T)) -> T
  "items" func items(comptime T: type, v: *Vec(T)) -> []T
  "items_mut" func items_mut(comptime T: type, v: *mut Vec(T)) -> []mut T
  "clear" func clear(comptime T: type, v: *mut Vec(T))
)
import "./lib/sort" (
  "sort" func sort(comptime T: type, xs: []mut T, comptime before: (T, T) -> bool)
)
import "./random" (
  "next" func next(r: *mut Rng) -> f64
  "one_of" func one_of(comptime T: type, r: *mut Rng, xs: []T) -> T
  "index_from" func index_from(comptime T: type, xs: []T, x: T, from: u32) -> i32
)
import "./board" (
  "gone" func gone() -> ?[]Pt
  "last" func last(p: []Pt) -> Pt
  "at" func slope_at(m: *SqMirrors, c: i32) -> i32
  "size" func size(m: *SqMirrors) -> i32
  "has_dup" func has_dup(cells: []i32) -> bool
)
import "./keys" (
  "KeySet" func KeySet(comptime W: type) -> type
  "KeyMap" func KeyMap(comptime W: type, comptime V: type) -> type
  "keyset" func keyset(comptime W: type, keys: u32, words: u32) -> *mut KeySet(W)
  "add_key" func add_key(comptime W: type, s: *mut KeySet(W), key: []W) -> bool
  "has_key" func has_key(comptime W: type, s: *KeySet(W), key: []W) -> bool
  "keymap" func keymap(comptime W: type, comptime V: type, keys: u32, words: u32) -> *mut KeyMap(W, V)
  "set_key" func set_key(comptime W: type, comptime V: type, m: *mut KeyMap(W, V), key: []W, v: V) -> bool
  "get_key" func get_key(comptime W: type, comptime V: type, m: *KeyMap(W, V), key: []W, fallback: V) -> V
)

// --- The canonical type block ---
type Pt = (q: i32, r: i32)
// --- end of the canonical type block ---
type Rng = (a: u32)
type SqMirrors = (slope: [*]mut i32, cells: i32, keys: *mut Vec(i32))

// The compact board (levels.js's boardOf): seq[i] is rope i's track, len[i] its length,
// off[i] how far along it has slid (-1 once it has left). By cell: occ, the rope on it
// (-1 for none), and at, the cell's index along that rope's track. was and now are
// relax()'s double buffer.
type SqBoard = (n: i32, left: i32, occ: [*]mut i32, at: [*]mut i32, seq: [*]mut []i32, len: [*]mut i32,
                off: [*]mut i32, was: [*]mut i32, now: [*]mut i32)

// What sq_solve found. solved: solved_yes with the taps in moves, solved_no when there
// is certainly no way, solved_unknown when the budget ran out first.
type Solved = (solved: i32, moves: []i32, nodes: i32)
def solved_yes = 1:i32
def solved_no = 0:i32
def solved_unknown = -1:i32  // enum: MoonBit's Bool?

// What sq_fewest_player_taps found: a plan, its player taps, whether the search
// finished, and the positions it looked at (the JS's nodes; MoonBit drops them).
type Par = (plan: []i32, par: i32, exact: bool, nodes: i32)

// What sq_replay did: whether the board emptied, the player taps, an event per tap, and
// the paths as they were left.
type Replayed = (solved: bool, taps: i32, events: []i32, paths: []?[]Pt)
def ev_exit = 0:i32
def ev_bounce = 1:i32
def ev_slide = 2:i32

def gone_at = 32767:i32   // relax(): where a rope that has left is (GONE)
def none = 1000000:i32    // the rank of a rope the preferred order does not name (1e6)

// n i32s, each v, on the stack.
func table(n: i32, v: i32) -> [*]mut i32 {
  assert n >= 0 && n < 0x10000000   // (n as u32) * 4 must not wrap
  let p = alloc((n as u32) * 4) as [*]mut i32
  p[0..n as u32] = v
  return p
}

// --- Geometry ---

// (dx, dy) turned by the mirror of slope s: '/' (0) sends it to (-dy, -dx), '\' (1)
// to (dy, dx).
export func turn(s: i32, dx: i32, dy: i32) -> (i32, i32) => if s == 0 { (-dy, -dx) } else { (dy, dx) }

// Which way a path's head points: one step from the cell behind it. A path runs from
// tail to head, and has two cells or more.
export func head_dir(path: []Pt) -> (dx: i32, dy: i32) {
  assert path.len >= 2
  let h = path.ptr[path.len - 1]  // unchecked: len >= 2
  let p = path.ptr[path.len - 2]  // unchecked: len >= 2
  dx = h.q - p.q
  dy = h.r - p.r
}

// Which way the head leaves: its direction, turned by a mirror on its own cell.
export func exit_dir(path: []Pt, w: i32, m: *SqMirrors) -> (i32, i32) {
  let h = last(path)
  let dx, dy = head_dir(path)
  let s = m.slope_at(h.r * w + h.q)
  return (dx, dy) when s < 0
  return turn(s, dx, dy)
}

// Pushes onto out the cells a head at (x0, y0) passes moving (dx0, dy0), up to the
// edge; a mirror turns it as it enters the mirror's cell. False if that way out would
// enter a cell twice: in the game such a tap overlaps itself or never settles.
export func ray_cells(x0: i32, y0: i32, dx0: i32, dy0: i32, w: i32, h: i32, m: *SqMirrors, out: *mut Vec(i32)) -> bool {
  let start = out.len
  let turned = false
  let x = x0
  let y = y0
  let dx = dx0
  let dy = dy0
  loop {
    x += dx
    y += dy
    break when x < 0 || y < 0 || x >= w || y >= h
    let c = y * w + x
    let s = m.slope_at(c)
    out.push(c)
    if s >= 0 {
      set (dx, dy) = turn(s, dx, dy)
      turned = true
      return false when out.len - start > (2 * w * h) as u32
    }
  }
  return !(turned && has_dup(out.ptr[start..out.len]))
}

// Stamps by cell for self_blocked: a cell is on the body when its stamp is the current one.
data body_marks = mut [0:i32; 2304]
global stamp: i32 = 0

// Would this rope's own body stand in its way out? Such a rope can never leave.
export func self_blocked(path: []Pt, w: i32, h: i32, m: *SqMirrors) -> bool {
  let hd = last(path)
  if m.size() > 0 {
    let scope = mark()
    defer reset(scope)
    let dx, dy = exit_dir(path, w, m)
    let ahead = vec(i32, 16)
    return true when !ray_cells(hd.q, hd.r, dx, dy, w, h, m, ahead)
    stamp += 1
    let body = body_marks as [*]mut i32
    for p in path {
      let cell = p.r * w + p.q
      assert cell >= 0 && cell < 2304
      body[cell] = stamp  // unchecked: asserted
    }
    for c in ahead.items() {
      return true when body[c] == stamp  // unchecked: a cell of the board
    }
    return false
  }
  let sx, sy = head_dir(path)
  for p in path {
    if sx != 0 {
      return true when p.r == hd.r && (p.q - hd.q) * sx > 0
    } elif p.q == hd.q && (p.r - hd.r) * sy > 0 {
      return true
    }
  }
  return false
}

// --- The board ---

// The board of these paths (a path is none once its rope has left), on the stack in
// the caller's scope. None if some rope's way out passes a cell twice.
export func sq_board(paths: []?[]Pt, w: i32, h: i32, m: *SqMirrors) -> ?*mut SqBoard {
  let n = paths.len as i32
  let occ = table(w * h, -1)
  let at = table(w * h, 0)
  let seq = alloc(paths.len * sizeof([]i32)) as [*]mut []i32
  let len = table(n, 0)
  let off = table(n, -1)
  let bent = m.size() > 0
  let left = 0
  for i, p in paths {
    seq[i] = []
    if let path = p {
      let hd = last(path)
      let dx, dy = head_dir(path)
      if bent {
        set (dx, dy) = exit_dir(path, w, m)
      }
      let s = vec(i32, path.len + 8)
      for c in path {  // closure: path.map(p => p.r * w + p.q)
        s.push(c.r * w + c.q)
      }
      if bent {
        return 0 as ?*mut SqBoard when !ray_cells(hd.q, hd.r, dx, dy, w, h, m, s)  // enum: none
      } else {
        let x = hd.q + dx
        let y = hd.r + dy
        while x >= 0 && y >= 0 && x < w && y < h {
          s.push(y * w + x)
          x += dx
          y += dy
        }
      }
      seq[i] = s.items()
      len[i] = path.len as i32
      for j, c in s.ptr[0..path.len] {
        occ[c] = i as i32  // unchecked: a cell of the board
        at[c] = j as i32
      }
      off[i] = 0
      left += 1
    }
  }
  let b = alloc(sizeof(SqBoard)) as *mut SqBoard
  b.* = SqBoard(n, left, occ, at, seq, len, off, table(n, 0), table(n, 0))
  return b
}

// sq_board, for paths whose ways out pass no cell twice (traps otherwise).
export func sq_board_exn(paths: []?[]Pt, w: i32, h: i32, m: *SqMirrors) -> *mut SqBoard {
  if let b = sq_board(paths, w, h, m) {
    return b
  }
  assert false  // A rope's way out passes a cell twice
  return 0 as *mut SqBoard
}

// Where rope i would stop if tapped: its new offset, or -1 if it would leave.
export func slide_to(b: *SqBoard, i: i32) -> i32 {
  let s = b.seq[i]  // unchecked: a rope
  let total = s.len as i32
  let l = b.len[i]
  let occ = b.occ
  let p = b.off[i] + l
  while p < total && occ[s.ptr[p]] == -1 {  // unchecked: p < total
    p += 1
  }
  return -1 when p == total
  return p - l
}

// Puts rope i at offset `to` (-1 takes it off the board). Also takes a move back.
export func place(b: *mut SqBoard, i: i32, to: i32) {
  let s = b.seq[i].ptr  // unchecked: a rope
  let l = b.len[i]
  let from = b.off[i]
  let occ = b.occ
  if from >= 0 {
    for c in s[from as u32..(from + l) as u32] {  // unchecked: the rope's cells
      occ[c] = -1
    }
    b.left -= 1
  }
  if to >= 0 {
    let at = b.at
    let p = to
    for c in s[to as u32..(to + l) as u32] {  // unchecked: the rope's cells
      occ[c] = i
      at[c] = p
      p += 1
    }
    b.left += 1
  }
  b.off[i] = to
}

// The relaxation: how many ropes certainly can never leave. Each rope pushes forward as
// far as it could have got given what the others managed in the round before; repeat
// until none moves. now[i] is where each got to (gone_at if out).
export func relax(b: *mut SqBoard) -> i32 {
  let n = b.n
  let was = b.was
  let now = b.now
  let off = b.off
  let occ = b.occ
  let at = b.at
  let waiting = 0
  for i in n {
    let v = if off[i] < 0 { gone_at } else { off[i] }
    was[i] = v
    now[i] = v
    if off[i] >= 0 {
      waiting += 1
    }
  }
  let moved = true
  while moved && waiting > 0 {
    moved = false
    for i in n {
      continue when was[i] == gone_at
      let s = b.seq[i]  // unchecked: a rope
      let total = s.len as i32
      let l = b.len[i]
      let r = was[i]
      loop {
        let p = r + l
        if p >= total {
          r = gone_at
          break
        }
        let c = s.ptr[p]  // unchecked: p < total
        let z = occ[c]
        // still in the way (its own body always is)
        break when z != -1 && (z == i as i32 || was[z] <= at[c])
        r += 1
      }
      if r != was[i] {
        now[i] = r
        moved = true
        if r == gone_at {
          waiting -= 1
        }
      }
    }
    for i in n {
      was[i] = now[i]
    }
  }
  return waiting
}

// True when no rope blocks another: every rope still on the board can leave at once.
export func all_free(b: *SqBoard) -> bool {
  for i in b.n {
    return false when b.off[i] >= 0 && b.slide_to(i as i32) >= 0
  }
  return true
}

// The paths on the board, none where a rope has left, in the caller's scope.
export func paths_of(b: *SqBoard, w: i32) -> []?[]Pt {  // closure: two Array::makei lambdas
  let out = alloc((b.n as u32) * sizeof(?[]Pt)) as [*]mut ?[]Pt
  for i in b.n {
    let o = b.off[i]
    if o < 0 {
      out[i] = gone()
    } else {
      let l = b.len[i] as u32
      let ps = alloc(l * sizeof(Pt)) as [*]mut Pt
      for j, c in b.seq[i].ptr[o as u32..o as u32 + l] {  // unchecked: the rope's cells
        ps[j] = Pt(c % w, c / w)
      }
      out[i] = ps[0..l]
    }
  }
  return out[0..b.n as u32]
}

// --- What the board says ---

// The ropes that can never move again, whatever is tapped (relax gets them nowhere).
export func sq_frozen(paths: []?[]Pt, w: i32, h: i32, m: *SqMirrors) -> []i32 {
  let b = sq_board_exn(paths, w, h, m)
  b.relax()
  let out = vec(i32, b.n as u32)
  for i in b.n {
    if b.now[i] == b.off[i] {
      out.push(i as i32)
    }
  }
  return out.items()
}

// True when no rope blocks another.
export func sq_free(paths: []?[]Pt, w: i32, h: i32, m: *SqMirrors) -> bool {
  let scope = mark()
  defer reset(scope)
  return sq_board_exn(paths, w, h, m).all_free()
}

// Each rope's whole track as cell indices, in the caller's scope; none if a way out
// passes a cell twice.
export func sq_tracks(paths: []?[]Pt, w: i32, h: i32, m: *SqMirrors) -> ?[][]i32 {
  if let b = sq_board(paths, w, h, m) {
    return b.seq[0..b.n as u32]
  }
  return (0 as [*][]i32, 0:u32)  // enum: the none of a ?[][]i32
}

// --- The solver ---

// A tap to try: rope i to offset `to`, tried in order of rank, then of i.
type Try = (i: i32, to: i32, rank: i32)
func first(a: Try, b: Try) -> bool => a.rank < b.rank || (a.rank == b.rank && a.i < b.i)  // closure: 2 comparator lambdas

// For each rope, where it first (rank) and last (later) comes in order: a knot is
// tapped twice, to slide and then to leave, and `later` is used once it has moved.
func ranks(n: i32, order: []i32, rank: [*]mut i32, later: [*]mut i32) {
  for k, i in order {
    if i >= 0 && i < n {
      if rank[i] == none {
        rank[i] = k as i32
      }
      later[i] = k as i32
    }
  }
}

// The search of sq_solve: its board, the positions found hopeless, the taps so far.
type Solve = (b: *mut SqBoard, hopeless: *mut KeySet(i32), moves: *mut Vec(i32), rank: [*]i32, later: [*]i32,
              nodes: i32, limit: i32, gave_up: bool)

// One node of the depth-first search.
func search(s: *mut Solve) -> bool {  // closure: search() of sq_solve
  let b = s.b
  return true when b.left == 0
  s.nodes += 1
  if s.nodes > s.limit {
    s.gave_up = true
    return false
  }
  let key = b.off[0..b.n as u32]
  return false when s.hopeless.has_key(key)
  if b.relax() > 0 {
    s.hopeless.add_key(key)
    return false
  }
  let scope = mark()
  defer reset(scope)
  let tries = vec(Try, b.n as u32)
  for i in b.n {
    let o = b.off[i]
    continue when o < 0
    let to = b.slide_to(i as i32)
    if to != o {
      let r = if o != 0 { s.later[i] } else { s.rank[i] }
      tries.push(Try(i as i32, to, r * 2 + (if to < 0 { 0 } else { 1 })))
    }
  }
  tries.items_mut().sort(first)
  for t in tries.items() {
    let from = b.off[t.i]
    b.place(t.i, t.to)
    assert s.moves.len < s.moves.cap  // reserve: moves outlives the node
    s.moves.push(t.i)
    return true when s.search()
    s.moves.pop()
    b.place(t.i, from)
    return false when s.gave_up
  }
  s.hopeless.add_key(key)
  return false
}

// Room for a search's positions: keys of n words, one per node at most.
func reserve(limit: i32, n: i32) -> (keys: u32, words: u32) {
  keys = (max(limit, 0) + 1) as u32
  assert keys <= 0x4000000 && (n == 0 || keys <= 0x10000000 / (n as u32))
  words = keys * (n as u32)
}

// An order of taps that clears the board: a depth-first search that gives up on knots
// that cannot be undone (relax), tries the taps of `prefer` first, then ropes that can
// leave, then slides, and never looks at a hopeless position twice. `budget` caps the
// positions looked at (0: 20,000). The moves are in the caller's scope.
export func sq_solve(paths: []?[]Pt, w: i32, h: i32, budget: i32, prefer: []i32, m: *SqMirrors) -> Solved {
  let limit = if budget == 0 { 20000 } else { budget }
  let room = reserve(limit, paths.len as i32)
  let moves = vec(i32, room.keys)  // reserve: a move per node at most
  let scope = mark()
  defer reset(scope)
  let b = sq_board_exn(paths, w, h, m)
  let rank = table(b.n, none)
  let later = table(b.n, none)
  ranks(b.n, prefer, rank, later)
  let s = alloc(sizeof(Solve)) as *mut Solve
  // reserve: a hopeless key per node
  // comptime-n: in an arena of its own (a second Stack(n)) the keys could grow as found,
  // instead of taking room for the whole budget up front: 17.8 MB, past the stack, at the
  // default budget on a 223-rope board.
  s.* = Solve(b, keyset(i32, room.keys, room.words), moves, rank, later, 0, limit, false)
  let ok = s.search()
  let state = if ok { solved_yes } elif s.gave_up { solved_unknown } else { solved_no }
  return Solved(state, moves.items(), s.nodes)
}

// --- The fewest taps ---

// The player taps of a solution: once no rope blocks another the rest is automatic.
// -1 if the taps do not clear the board, or one does not move its rope.
export func sq_player_taps(paths: []?[]Pt, w: i32, h: i32, taps: []i32, m: *SqMirrors) -> i32 {
  let scope = mark()
  defer reset(scope)
  let b = sq_board_exn(paths, w, h, m)
  let count = 0
  let released = false
  for i in taps {
    assert i >= 0 && i < b.n
    continue when b.off[i] < 0
    let to = b.slide_to(i)
    return -1 when to == b.off[i]  // enum: none
    if !released {
      count += 1
    }
    b.place(i, to)
    if !released && b.all_free() {
      released = true
    }
  }
  return -1 when b.left > 0  // enum: none
  return count
}

// The search of sq_fewest_player_taps.
type Fewest = (b: *mut SqBoard, tried: *mut KeyMap(i32, i32), moves: *mut Vec(i32), rank: [*]i32, later: [*]i32,
               blockers: [*]mut u8, nodes: i32, limit: i32, gave_up: bool)

// Every rope standing in another's way out must move before all are free: a lower
// bound on the player taps left.
func bound(s: *Fewest) -> i32 {  // closure: bound() of sq_fewest_player_taps
  let b = s.b
  let blockers = s.blockers
  let occ = b.occ
  blockers[0..b.n as u32] = 0
  let total = 0
  for i in b.n {
    let o = b.off[i]
    if o >= 0 {
      let seq = b.seq[i]  // unchecked: a rope
      for c in seq.ptr[(o + b.len[i]) as u32..seq.len] {
        let z = occ[c]  // unchecked: a cell of the board
        if z >= 0 && blockers[z] == 0 {
          blockers[z] = 1
          total += 1
        }
      }
    }
  }
  return total
}

// One node of the deepening search: can the board be freed with `remaining` taps?
func deepen(s: *mut Fewest, remaining: i32) -> bool {  // closure: search() of sq_fewest_player_taps
  let b = s.b
  return true when b.all_free()
  return false when remaining == 0 || s.bound() > remaining
  s.nodes += 1
  if s.nodes > s.limit {
    s.gave_up = true
    return false
  }
  let key = b.off[0..b.n as u32]
  return false when s.tried.get_key(key, -1) >= remaining
  if b.relax() > 0 {
    s.tried.set_key(key, none)
    return false
  }
  let scope = mark()
  defer reset(scope)
  let choices = vec(Try, b.n as u32)
  for i in b.n {
    let o = b.off[i]
    if o >= 0 {
      let to = b.slide_to(i as i32)
      if to != o {
        choices.push(Try(i as i32, to, if o != 0 { s.later[i] } else { s.rank[i] }))
      }
    }
  }
  choices.items_mut().sort(first)
  for t in choices.items() {
    let from = b.off[t.i]
    b.place(t.i, t.to)
    assert s.moves.len < s.moves.cap  // reserve: moves outlives the node
    s.moves.push(t.i)
    return true when s.deepen(remaining - 1)
    s.moves.pop()
    b.place(t.i, from)
    return false when s.gave_up
  }
  s.tried.set_key(key, remaining)
  return false
}

// A solution with as few player taps as can be found: a search that deepens one tap at
// a time from a lower bound, up to the player taps of `known` (a solution in hand,
// whose taps it tries first). `budget` caps the positions looked at (0: 6,000). None
// if `known` is not a solution. The plan is in the caller's scope.
export func sq_fewest_player_taps(paths: []?[]Pt, w: i32, h: i32, known: []i32, budget: i32, m: *SqMirrors) -> ?*Par {
  let count = sq_player_taps(paths, w, h, known, m)
  return 0 as ?*Par when count < 0  // enum: none
  let par = alloc(sizeof(Par)) as *mut Par
  let moves = vec(i32, known.len + paths.len)  // reserve: fewer taps than known's, then the free ropes
  let scope = mark()
  defer reset(scope)
  let b = sq_board_exn(paths, w, h, m)
  let limit = if budget == 0 { 6000 } else { budget }
  let rank = table(b.n, none)
  let later = table(b.n, none)
  ranks(b.n, known, rank, later)
  let room = reserve(limit, b.n)
  let s = alloc(sizeof(Fewest)) as *mut Fewest
  // reserve: a key per node
  // comptime-n: as sq_solve's (2.2 MB at 2,500 on 223 ropes)
  s.* = Fewest(b, keymap(i32, i32, room.keys, room.words), moves, rank, later, alloc(b.n as u32) as [*]mut u8, 0, limit, false)
  let k = max(if b.left > 0 { 1 } else { 0 }, s.bound())
  while k < count && !s.gave_up {
    if s.deepen(k) {
      let manual = moves.len as i32
      // each rope left is free: these taps are the automatic release
      for i in b.n {
        if b.off[i] >= 0 {
          moves.push(i as i32)
        }
      }
      par.* = Par(moves.items(), manual, true, s.nodes)
      return par
    }
    k += 1
  }
  par.* = Par(known, count, !s.gave_up, s.nodes)
  return par
}

// Moves exits the rest of the solution does not need to the automatic release, while
// that lowers the player taps (two passes at most). None if taps is not a solution.
// The taps are in the caller's scope.
export func sq_postpone_exits(paths: []?[]Pt, w: i32, h: i32, taps: []i32, m: *SqMirrors) -> ?[]i32 {
  let count = sq_player_taps(paths, w, h, taps, m)
  return (0 as [*]i32, 0:u32) when count < 0  // enum: the none of a ?[]i32
  let n = taps.len
  let best = alloc(n * 4) as [*]mut i32
  let trial = alloc(n * 4) as [*]mut i32
  for k, i in taps {
    best[k] = i
  }
  for pass in 2 {
    let improved = false
    let k = n as i32 - 1
    while k >= 0 {
      let i = best[k]
      // only a rope's last tap is its exit
      if index_from(best[0..n], i, (k + 1) as u32) < 0 {
        // best without its k-th tap, then that tap last
        for j, x in best[0..k as u32] {
          trial[j] = x
        }
        for j, x in best[(k + 1) as u32..n] {
          trial[k as u32 + j] = x
        }
        trial[n - 1] = i
        let c = sq_player_taps(paths, w, h, trial[0..n], m)
        if c >= 0 && c < count {
          let was_best = best
          best = trial
          trial = was_best
          count = c
          improved = true
        }
      }
      k -= 1
    }
    break when !improved
  }
  return best[0..n]
}

// --- Replays and play ---

// Replays taps as the game does: each tap must move its rope, and player taps are
// counted until no rope blocks another. Stops at the first tap that moves nothing.
// Everything is in the caller's scope.
export func sq_replay(paths: []?[]Pt, w: i32, h: i32, taps: []i32, m: *SqMirrors) -> Replayed {
  let b = sq_board_exn(paths, w, h, m)
  let events = vec(i32, taps.len)
  let count = 0
  let released = false
  for i in taps {
    assert i >= 0 && i < b.n
    let o = b.off[i]
    let to = if o < 0 { o } else { b.slide_to(i) }
    return Replayed(false, count, events.items(), b.paths_of(w)) when to == o
    if !released {
      count += 1
    }
    b.place(i, to)
    events.push(if to < 0 { ev_exit } else { ev_slide })
    if b.all_free() {
      released = true
    }
  }
  return Replayed(b.left == 0, count, events.items(), b.paths_of(w))
}

// The casual player: taps a rope that can leave if there is one, otherwise any rope
// that can move, at random. The share of `games` it wins. Each game starts the board
// again, ropes that had left included (as the JS does).
export func sq_casual_wins(paths: []?[]Pt, w: i32, h: i32, r: *mut Rng, games: i32, m: *SqMirrors) -> f64 {
  let scope = mark()
  defer reset(scope)
  let b = sq_board_exn(paths, w, h, m)
  let n = b.n
  let exits = vec(i32, n as u32)
  let moves = vec(i32, 2 * n as u32)
  let area = (w * h) as u32
  let wins = 0
  for g in games {
    b.occ[0..area] = -1
    b.left = 0
    for i in n {
      b.off[i] = -1
      b.place(i as i32, 0)
    }
    loop {
      exits.clear()
      moves.clear()
      let off = b.off
      let seq = b.seq
      let len = b.len
      let occ = b.occ
      for i in n {
        let o = off[i]
        if o >= 0 {
          // inline: b.slide_to(i), with the board's tables in locals: 20% of the
          // time of casual play (inline func is parsed but not yet implemented)
          let s = seq[i]
          let total = s.len as i32
          let p = o + len[i]
          while p < total && occ[s.ptr[p]] == -1 {
            p += 1
          }
          let to = if p == total { -1 } else { p - len[i] }
          if to < 0 {
            exits.push(i as i32)
          } elif to != o {
            moves.push(i as i32)
            moves.push(to)
          }
        }
      }
      if exits.len > 0 {
        b.place(r.one_of(exits.items()), -1)
      } elif moves.len > 0 {
        let k = 2 * i32(floor(r.next() * f64(moves.len) / 2.0))
        b.place(moves.ptr[k], moves.ptr[k + 1])  // unchecked: k < moves.len, even
      } else {
        break
      }
      if b.left == 0 {
        wins += 1
        break
      }
    }
  }
  return f64(wins) / f64(max(1, games))
}

// --- Tests ---

test "turn" {
  let a, c = turn(0, 1, 0)
  assert a == 0 && c == -1
  let d, e = turn(1, 1, 0)
  assert d == 0 && e == 1
}

// A 3 x 3 board: rope 0 on (0, 1), (1, 1) heads +x into rope 1, on (2, 2), (2, 1),
// which heads -y off the board.
func two_ropes() -> []?[]Pt {
  let pts = alloc(4 * sizeof(Pt)) as [*]mut Pt
  pts[0] = Pt(0, 1)
  pts[1] = Pt(1, 1)
  pts[2] = Pt(2, 2)
  pts[3] = Pt(2, 1)
  let paths = alloc(2 * sizeof(?[]Pt)) as [*]mut ?[]Pt
  paths[0] = pts[0..2]
  paths[1] = pts[2..4]
  return paths[0..2]
}

func nothing() -> *SqMirrors {
  let m = alloc(sizeof(SqMirrors)) as *mut SqMirrors
  m.* = SqMirrors(alloc(0) as [*]mut i32, 0, vec(i32, 1))
  return m
}

test "a rope in another's way" {
  let scope = mark()
  defer reset(scope)
  let paths = two_ropes()
  let m = nothing()
  let b = sq_board_exn(paths, 3, 3, m)
  assert b.n == 2 && b.left == 2
  assert b.seq[0].len == 3 && b.seq[1].len == 3
  assert b.slide_to(0) == 0 && b.slide_to(1) == -1
  assert !b.all_free()
  assert b.relax() == 0
  b.place(1, -1)
  assert b.left == 1 && b.all_free() && b.slide_to(0) == -1
  assert !sq_free(paths, 3, 3, m)
  assert sq_frozen(paths, 3, 3, m).len == 0
  let s = sq_solve(paths, 3, 3, 0, [], m)
  assert s.solved == solved_yes && s.nodes == 2  // the empty board is not counted
  assert s.moves.len == 2 && (s.moves[0] ?? -1) == 1 && (s.moves[1] ?? -1) == 0
  assert sq_player_taps(paths, 3, 3, s.moves, m) == 1
  assert sq_player_taps(paths, 3, 3, [0:i32, 1], m) == -1
  let r = sq_replay(paths, 3, 3, s.moves, m)
  assert r.solved && r.taps == 1 && r.events.len == 2
  if let f = sq_fewest_player_taps(paths, 3, 3, s.moves, 0, m) {
    assert f.par == 1 && f.exact
  } else {
    assert false
  }
}

test "a rope whose way out runs into its own body" {
  // on a 4 x 2 board: (3, 1) (3, 0) (2, 0) (1, 0) (1, 1) (2, 1), heading +x into (3, 1)
  let pts = alloc(6 * sizeof(Pt)) as [*]mut Pt
  pts[0] = Pt(3, 1)
  pts[1] = Pt(3, 0)
  pts[2] = Pt(2, 0)
  pts[3] = Pt(1, 0)
  pts[4] = Pt(1, 1)
  pts[5] = Pt(2, 1)
  assert self_blocked(pts[0..6], 4, 2, nothing())
  assert !self_blocked(pts[1..6], 4, 2, nothing())
}
