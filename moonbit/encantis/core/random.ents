// random.mbt of the MoonBit core (random.js of the game at 9e69e3a), bit for bit:
// mulberry32 behind a *mut Rng, FNV-1a, base 36 and decimal text, Math.round and
// Math.floor of a quotient, and the small list helpers every module uses.
//
// Strings are bytes ([]u8): every string the core hashes is ASCII, where bytes
// and UTF-16 code units agree. Nothing concatenates. Text is written to a sink,
// one byte at a time, by a comptime function: hash_byte streams it into FNV-1a,
// and a writer of another module can put it in a Vec(u8) or the output words. So
// hashString('grid/3/' + code + '/' + i) is fnv().text("grid/3/", hash_byte)...
// with no string built.
//
// Every draw is counted (draws()), and with tracing on, the bound of each one
// is kept in a ring of the last 65,536 (0 for a draw of next() itself), to find
// the first draw where a port and the JS part.
//
// ssort of random.mbt is lib/sort (stable, with a comptime `before`); imin,
// imax, dmin and dmax are the builtins min and max.

import "./lib/stack" (
  "alloc" func alloc(n: u32) -> u32
)
import "./lib/vec" (
  "Vec" func Vec(comptime T: type) -> type
  "vec" func vec(comptime T: type, cap: u32) -> *mut Vec(T)
  "push" func push(comptime T: type, v: *mut Vec(T), x: T)
)

// mulberry32's state. u32 arithmetic wraps, so `*` is Math.imul and `>>` is >>>.
type Rng = (a: u32)

global count: u32 = 0
global tracing: bool = false
data trace = mut [0:u32; 65536]

// The draws made since the last reset_draws.
export func draws() -> u32 => count

// Starts the count again, and the trace with it when on is true.
export func reset_draws(on: bool) {
  count = 0
  tracing = on
}

// The bound of draw k (0 for next() itself), while k is among the last 65,536.
export func traced(k: u32) -> u32 => trace[k & 0xFFFF]

// A generator seeded with seed, on the stack: mulberry32(seed) of random.js.
export func rng(seed: u32) -> *mut Rng {
  let r = alloc(sizeof(Rng)) as *mut Rng
  r.* = Rng(seed)
  return r
}

// The next number in [0, 1): k / 2^32 for a 32-bit k.
export func next(r: *mut Rng) -> f64 {
  if tracing {
    trace[count & 0xFFFF] = 0
  }
  count += 1
  r.a += 0x6D2B79F5
  let a = r.a
  let t: u32 = (a ^ (a >> 15)) * (1 | a)
  t = (t + (t ^ (t >> 7)) * (61 | t)) ^ t
  return f64(t ^ (t >> 14)) / 4294967296.0
}

// Math.floor(rng() * n): an index below n.
export func below(r: *mut Rng, n: i32) -> i32 {
  let x = r.next()
  if tracing {
    trace[(count - 1) & 0xFFFF] = n as u32
  }
  return i32(floor(x * n))
}

// rng() < p
export func chance(r: *mut Rng, p: f64) -> bool => r.next() < p

// xs[below(xs.length)]: an element of xs, at random. xs must not be empty.
export func one_of(comptime T: type, r: *mut Rng, xs: []T) -> T => xs.ptr[r.below(xs.len as i32)]  // unchecked: below(n) < n

// --- FNV-1a (hashString), and text written one byte at a time ---

// The FNV-1a offset basis: the hash of the empty string.
export func fnv() -> u32 => 0x811c9dc5

// One more byte of FNV-1a. The sink for hashing text.
export func hash_byte(h: u32, c: u8) -> u32 => (h ^ c) * 0x01000193

// hashString(s) for an ASCII s.
export func hash_text(s: []u8) -> u32 => fnv().text(s, hash_byte)

// The bytes of t, to the sink.
export func text(comptime S: type, s: S, t: []u8, comptime put: (S, u8) -> S) -> S {
  for c in t {
    s = put(s, c)
  }
  return s
}

// v in decimal, as String(v) and JSON.stringify write an integer.
export func dec(comptime S: type, s: S, v: i32, comptime put: (S, u8) -> S) -> S {
  let u = v as u32
  if v < 0 {
    s = put(s, '-')
    u = (0 - v) as u32
  }
  let d: u32 = 1
  while u / d >= 10 {
    d *= 10
  }
  loop {
    s = put(s, '0' + ((u / d) % 10) as u8)
    break when d == 1
    d /= 10
  }
  return s
}

// u.toString(36), in lower case, or upper case with upper (as the seeds are).
export func base36(comptime S: type, s: S, u: u32, upper: bool, comptime put: (S, u8) -> S) -> S {
  let d: u32 = 1
  while u / d >= 36 {
    d *= 36
  }
  loop {
    let x = ((u / d) % 36) as u8
    let c = if x < 10 { '0' + x } elif upper { 'A' + x - 10 } else { 'a' + x - 10 }
    s = put(s, c)
    break when d == 1
    d /= 36
  }
  return s
}

// A sink that collects the bytes, for text that is output or kept.
export func collect(v: *mut Vec(u8), c: u8) -> *mut Vec(u8) {
  v.push(c)
  return v
}

// --- Numbers as the JS computes them ---

// Math.round: halves round up, toward +Infinity, and a result of zero keeps
// the sign of x (Math.round(-0.3) is -0).
export func js_round(x: f64) -> f64 {
  let f = floor(x)
  return copysign(f + 1.0, x) when x - f >= 0.5
  return f
}

// Math.round(x) as an i32, as random.mbt's js_round returns it.
export func round_i(x: f64) -> i32 => i32(js_round(x))

// Math.floor(a / b) for b > 0.
export func floor_div(a: i32, b: i32) -> i32 => if a >= 0 { a / b } else { -((-a + b - 1) / b) }

// --- Lists ---

// The index of the first x in xs at or after from, or -1.
export func index_from(comptime T: type, xs: []T, x: T, from: u32) -> i32 {
  let k = from
  while k < xs.len {
    return k as i32 when xs.ptr[k] == x  // unchecked: k < xs.len
    k += 1
  }
  return -1
}

export func contains(comptime T: type, xs: []T, x: T) -> bool => index_from(xs, x, 0) >= 0

// [...new Set(xs)]: the first of each, in order, in a new Vec.
export func unique(comptime T: type, xs: []T) -> *mut Vec(T) {
  let out = vec(T, xs.len)
  for x in xs {
    if !contains(out.ptr[0..out.len], x) {
      out.push(x)
    }
  }
  return out
}

// Reverses xs in place (rev_in_place).
export func reverse(comptime T: type, xs: []mut T) {
  let p = xs.ptr
  let i: u32 = 0
  let j = xs.len
  while i + 1 < j {
    j -= 1
    let t = p[i]
    p[i] = p[j]
    p[j] = t
    i += 1
  }
}

// --- Tests ---

test "mulberry32 and hashString give what random.js gives" {
  // random_test.mbt's values, from V8
  assert hash_text("grid/3/1E36ZS5") == 2737516719
  let r = rng(hash_text("grid/3/1E36ZS5"))
  assert r.next() == 0.254515414359048
  assert r.next() == 0.8429008759558201
  assert r.next() == 0.3264201944693923
  let s = rng(1)
  assert s.next() * 4294967296.0 == 2693262067.0
}

test "below, chance and one_of draw once each, and are counted" {
  reset_draws(true)
  let r = rng(12345)
  assert r.below(1000) == 979
  assert r.below(7) == 2
  assert r.chance(0.5)
  assert r.one_of(i32, [10, 20, 30, 40, 50]) == 50
  assert draws() == 4
  assert traced(0) == 1000
  assert traced(2) == 0
  assert traced(3) == 5
  reset_draws(false)
}

test "base 36 and decimal, as toString writes them" {
  assert fnv().base36(4294967295, false, hash_byte) == fnv().text("1z141z3", hash_byte)
  assert fnv().base36(fnv(), true, hash_byte) == hash_text("ZTNTFP")
  assert fnv().base36(0, false, hash_byte) == hash_text("0")
  assert fnv().dec(-2147483648, hash_byte) == hash_text("-2147483648")
  assert fnv().dec(0, hash_byte) == hash_text("0")
  assert fnv().dec(1000, hash_byte) == hash_text("1000")
}

test "js_round and floor_div follow Math.round and Math.floor" {
  assert js_round(2.5) == 3.0
  assert js_round(-2.5) == -2.0
  assert round_i(-2.5) == -2
  assert js_round(0.49999999999999994) == 0.0
  assert copysign(1.0, js_round(-0.3)) == -1.0
  assert floor_div(-1, 2) == -1
  assert floor_div(-4, 2) == -2
  assert floor_div(5, 2) == 2
}

data some = [3:i32, 1, 3, 2, 1]

test "index_from, contains, unique and reverse" {
  assert index_from(some, 3, 1) == 2
  assert index_from(some, 7, 0) == -1
  assert contains(some, 2)
  let u = unique(some)
  assert u.len == 3
  assert u.ptr[2] == 2
  let m = alloc(12) as [*]mut i32
  m[0] = 1
  m[1] = 2
  m[2] = 3
  reverse(m[0..3])
  assert m[0] == 3 && m[2] == 1
}
