// hex.mbt of the MoonBit core, lines 669 to 1238: the Hex woven builder of hex/engine.js at
// 9e69e3a. hex_intentions replays a board with the cells each rope must stop at, and measures
// how deeply the ropes wait on one another; hex_build lays a level backwards from the solved
// board with that replay as its certificate: pairs of ropes that must wait on each other
// (knots), ropes with a short gap ahead that loses the board if slid into (traps), then long
// winding ropes, the best of twelve candidates at each step, until the board is covered.
//
// Builder state. In the JS, build is one function whose seven closures (free, ray, shape,
// aimAt, noteTurns, tryTrap and intentions' step) share its locals. Here those locals are
// module globals, set up again by every call (`// closure:`): one builder runs at a time, as
// for weave.ents. intentions' step keeps its locals in a context struct instead (Intent),
// because hex_intentions is also called on its own.
//
// Memory is the bump stack, in scopes:
//   the caller's  what hex_build returns: the ropes' cells (pool), the rope list and the plan,
//                 their room taken first
//   the call      the board's tables, the stops, the kept candidate
//   a step        one knot attempt, one trap attempt, or one of the twelve candidates: its
//                 shape, the board intentions compiles for it, the replay
// A candidate's shape is made in its step's scope, so what is kept of it is copied out: the
// cells of a rope laid for good go to the pool (commit), the best candidate of twelve to
// best_ids and best_moves, and each certificate taken to plan. Those lists last for the call
// and are written in a step, so they are given all their room up front (`// reserve:`): the
// ropes never share a cell, so they hold at most area cells and area / 2 ropes.
//
// Options: shape and the replays return ?*T in the caller's scope; an aim is a head of -1 for
// none (`// enum:`, MoonBit's (Int32, Int32)?).

import "./lib/stack" (
  "mark" func mark() -> u32
  "reset" func reset(m: u32)
  "alloc" func alloc(n: u32) -> u32
  "zeroed" func zeroed(n: u32) -> u32
)
import "./lib/vec" (
  "Vec" func Vec(comptime T: type) -> type
  "vec" func vec(comptime T: type, cap: u32) -> *mut Vec(T)
  "push" func push(comptime T: type, v: *mut Vec(T), x: T)
  "pop" func pop(comptime T: type, v: *mut Vec(T)) -> T
  "last" func last_of(comptime T: type, v: *Vec(T)) -> T
  "items" func items(comptime T: type, v: *Vec(T)) -> []T
  "clear" func clear(comptime T: type, v: *mut Vec(T))
)
import "./lib/fixedvec" (
  "FixedVec" func FixedVec(comptime n: u32, comptime T: type) -> type
  "push" func fixed_push(comptime n: u32, comptime T: type, v: *mut FixedVec(n, T), x: T) -> bool
  "items" func fixed_items(comptime n: u32, comptime T: type, v: *FixedVec(n, T)) -> []T
  "clear" func fixed_clear(comptime n: u32, comptime T: type, v: *mut FixedVec(n, T))
)
import "./random" (
  "next" func next(r: *mut Rng) -> f64
  "below" func below(r: *mut Rng, n: i32) -> i32
  "one_of" func one_of(comptime T: type, r: *mut Rng, xs: []T) -> T
  "contains" func contains(comptime T: type, xs: []T, x: T) -> bool
)
import "./board" (
  "last" func last(p: []Pt) -> Pt
  "size" func size(m: *SqMirrors) -> i32
)
import "./hex" (
  "hex_inside" func hex_inside(w: i32, h: i32, p: Pt) -> bool
  "hex_cell" func hex_cell(p: Pt, w: i32) -> i32
  "hex_point" func hex_point(c: i32, w: i32) -> Pt
  "hex_dir" func hex_dir(d: i32) -> Pt
  "hex_mirrors" func hex_mirrors(w: i32, h: i32, mirrors: []Mirror) -> *mut SqMirrors
  "ray_track" func ray_track(w: i32, h: i32, head: i32, d0: i32, m: *SqMirrors, out: *mut Vec(i32), turns: ?*mut Vec(i32)) -> bool
  "exit_index" func exit_index(w: i32, path: []Pt, m: *SqMirrors) -> i32
  "hex_compile" func hex_compile(w: i32, h: i32, mirrors: []Mirror, paths: []?[]Pt) -> ?*mut HexBoard
  "hex_compile_exn" func hex_compile_exn(w: i32, h: i32, mirrors: []Mirror, paths: []?[]Pt) -> *mut HexBoard
  "to" func to(b: *HexBoard, i: i32) -> i32
  "place" func place(b: *mut HexBoard, i: i32, target: i32)
  "dead" func dead(b: *HexBoard) -> bool
)

// --- The canonical type block ---
type Pt = (q: i32, r: i32)
type Mirror = (cell: Pt, kind: i32)       // kind: the axis on Hex; 1 for '\', 0 for '/' on square
// --- end of the canonical type block ---
type Rng = (a: u32)
type SqMirrors = (slope: [*]mut i32, cells: i32, keys: *mut Vec(i32))
type HexBoard = (w: i32, n: i32, left: i32, tracks: [*]mut []i32, lengths: [*]mut i32, offsets: [*]mut i32,
                 occupied: [*]mut i32, at: [*]mut i32, reach: [*]mut i32)

// What a replay with stops gives (HexIntent; MoonBit keeps moves and cost): the moves in the
// order made, the summed layers of the exits, the deepest layer, and the slides made.
type HexIntent = (moves: []i32, cost: i32, depth: i32, slides: i32)

// What hex_build is asked for (HexCfg). initial_ropes is the repeated-slide core, from tail to
// head (empty without one); initial_stops gives per core rope the offsets it stops at;
// initial_plan is the core's certificate, or none.
type HexCfg = (w: i32, h: i32, stage: i32, coverage: f64, length: i32, tap_depth: f64, mirrors: []Mirror,
               knots: i32, traps: i32, initial_ropes: [][]Pt, initial_stops: [][]i32, initial_plan: ?[]i32)

// What hex_build made (HexBuilt): the ropes from tail to head, the certificate, and beside
// MoonBit's two fields what the JS's result also says: the stops (per rope the head cells it
// stops at), the knots made (slides), the traps made, and the certified replay's deepest layer
// and summed exit layers (stats.depth, and stats.averageDepth times the rope count).
type HexBuilt = (ropes: [][]Pt, stops: [][]i32, plan: []i32, slides: i32, traps: i32, depth: i32, cost: i32)

// No numbers.
func empty() -> []i32 => (0 as [*]i32)[0..0]

// n i32s, each v, on the stack.
func table(n: i32, v: i32) -> [*]mut i32 {
  assert n >= 0 && n < 0x10000000   // (n as u32) * 4 must not wrap
  let p = alloc((n as u32) * 4) as [*]mut i32
  p[0..n as u32] = v
  return p
}

// --- Replays with stops ---

// The state of one replay (intentions() of the JS): the board, the stops, and by rope the
// stops passed (done) and the layer it last moved at (moved_at); by cell the layer at which it
// was last left empty (released).
type Intent = (b: *mut HexBoard, stops: [][]i32, done: [*]mut i32, released: [*]mut i32, moved_at: [*]mut i32,
               moves: *mut Vec(i32), cost: i32, depth: i32, slides: i32)

// Taps rope i if it moves where its stops say: to its next stop's cell, or out once its stops
// are passed. Its layer is one more than the deepest of what it waited on: the cells it passes
// and the rope it stops against. False, with nothing changed, otherwise.
func step(s: *mut Intent, i: i32) -> bool {  // closure: step() of intentions
  let b = s.b
  let target = b.to(i)
  return false when target == -2
  let from = b.offsets[i]  // unchecked: to(i) != -2, so i is a rope
  return false when target == from
  let expected = s.stops[i] ?? empty()  // a rope with no stops given has none
  let k = s.done[i]  // unchecked: a rope
  let stop = expected[k] ?? -1  // -1: no stop left, so it must leave
  let length = b.lengths[i]
  let track = b.tracks[i].ptr  // unchecked: the indices below are on the track
  if stop >= 0 {
    return false when target < 0 || track[target + length - 1] != stop
  } elif target != -1 {
    return false
  }
  let released = s.released
  let layer = s.moved_at[i]
  let end = if target < 0 { b.tracks[i].len as i32 } else { target + length }
  for j in (end - from - length) as u32 {
    layer = max(layer, released[track[from + length + j as i32]])
  }
  if target >= 0 {
    let owner = b.occupied[track[end]]
    if owner >= 0 {
      layer = max(layer, s.moved_at[owner])  // unchecked: a rope
    }
    s.slides += 1
  }
  layer += 1
  s.moved_at[i] = layer
  s.depth = max(s.depth, layer)
  let stop_at = if target < 0 { from + length } else { min(from + length, target) }
  for c in track[from as u32..stop_at as u32] {  // unchecked: the rope's cells
    released[c] = layer
  }
  b.place(i, target)
  s.done[i] = k + 1
  assert s.moves.len < s.moves.cap  // reserve: a move per stop and one more per rope
  s.moves.push(i)
  if target < 0 {
    s.cost += layer
  }
  return true
}

// Replays the board of these paths with the given stops (per rope the head cells it must
// stop at, in order, then it leaves): by the certificate's moves if given, each of which must
// move as its stops say; else tapping every rope that can, from the last to the first, until
// none can. None unless the board empties. In the caller's scope.
export func hex_intentions(w: i32, h: i32, mirrors: []Mirror, paths: []?[]Pt, stops: [][]i32, certificate: ?[]i32) -> ?*HexIntent {
  let n = paths.len as i32
  let b = hex_compile_exn(w, h, mirrors, paths)
  let room = paths.len
  for s in stops {
    room += s.len
  }
  let s = alloc(sizeof(Intent)) as *mut Intent
  s.* = Intent(b, stops, table(n, 0), table(w * h, 0), table(n, 0), vec(i32, room), 0, 0, 0)
  if let cert = certificate {
    for i in cert {
      return 0 as ?*HexIntent when !s.step(i)  // enum: none
    }
  } else {
    let changed = true
    while changed && b.left > 0 {
      changed = false
      for k in n {
        if s.step(n - 1 - k as i32) {
          changed = true
        }
      }
    }
  }
  return 0 as ?*HexIntent when b.left > 0  // enum: none
  let out = alloc(sizeof(HexIntent)) as *mut HexIntent
  out.* = HexIntent(s.moves.items(), s.cost, s.depth, s.slides)
  return out
}

// --- Builder state (one hex_build at a time; set up again by every call) ---

global gen: *mut Rng = 0
global cfg: *HexCfg = 0
global bw: i32 = 0                    // the board's columns, rows and cells
global bh: i32 = 0
global area: i32 = 0
global nb: [*]mut i32 = 0             // neighbours: cell c's in direction d at c * 6 + d, -1 off the board
global occupied: [*]mut i32 = 0       // per cell: the rope laid on it, -1, or 9999 while a knot's first rope is held
global seen: [*]mut i32 = 0           // per cell: the stamp of the shape that took it
global forward: [*]mut i32 = 0        // per cell: the stamp of the shape whose way out crosses it
global tile: [*]mut u8 = 0            // per cell: 1 where a mirror stands
global kept: [*]mut u8 = 0            // per cell: 1 in the gap ahead of a trap, which no rope may fill
global turned_by: [*]mut u8 = 0       // per cell: 1 on a mirror some laid rope's way out turns on
global turned_count: i32 = 0
global bent: *mut SqMirrors = 0       // the mirrors by cell
global ropes: *mut Vec(?[]Pt) = 0     // reserve: the ropes laid, and the candidate being tried
global rope_stops: *mut Vec([]i32) = 0  // reserve: per rope the head cells it stops at
global stop1: [*]mut i32 = 0          // per rope: the one stop a knot's rope is given (stops[i] is stop1[i..i + 1])
global pool: *mut Vec(Pt) = 0         // reserve: the cells of every rope laid for good
global plan: *mut Vec(i32) = 0        // reserve: the certificate of the board as laid (result.moves)
global plan_cost: i32 = 0             // and its cost (result.cost)
global best_ids: *mut Vec(i32) = 0    // reserve: the best candidate of a step, its cells
global best_moves: *mut Vec(i32) = 0  // reserve: and its certificate
global best_cost: i32 = 0
global stamp: i32 = 0
global covered: i32 = 0
global knots: i32 = 0
global traps: i32 = 0

// A candidate rope (HexShape): its cells from tail to head as cell indices (ids) and as points
// (path), the cells ahead of its head (ray), and the mirrors its way out turns on (turns).
type Shape = (ids: []i32, path: []Pt, ray: []i32, turns: []i32)

// Where a shape must start: its head and the direction it leaves in. A head of -1 is none
// (enum: MoonBit's (Int32, Int32)?).
type Aim = (head: i32, dir: i32)
func no_aim() -> Aim => Aim(-1, 0)  // enum: none

// The six-direction lists of shape and aim_at (MoonBit's choices and dirs, an Array each).
// comptime-n: FixedVec(6, i32) in static data, its bound in its type
data choice_cells = mut [0:i32; 6]
data choices: FixedVec(6, i32) = mut (0, choice_cells)
data dir_cells = mut [0:i32; 6]
data dirs: FixedVec(6, i32) = mut (0, dir_cells)

func no_stops() -> []i32 => stop1[0..0]

// The neighbour of cell c in direction d, -1 off the board (c >= 0).
func step_to(c: i32, d: i32) -> i32 => nb[c * 6 + d]  // unchecked: c a cell, d below 6

// A cell no rope, mirror or kept gap holds (free()).
func free(c: i32) -> bool => c >= 0 && occupied[c] < 0 && tile[c] == 0 && kept[c] == 0  // unchecked: a cell

// The cells ahead of `head` going in direction d, to the edge (ray()); none where the way out
// would pass a cell twice. In the caller's scope.
func ray(head: i32, d: i32, out: *mut Vec(i32)) -> bool {
  if bent.size() > 0 {
    return ray_track(bw, bh, head, d, bent, out, 0 as ?*mut Vec(i32))
  }
  let c = step_to(head, d)
  while c >= 0 {
    out.push(c)
    c = step_to(c, d)
  }
  return true
}

// The replay of the ropes as laid, with their stops (intent()).
func intent(cert: ?[]i32) -> ?*HexIntent => hex_intentions(bw, bh, cfg.mirrors, ropes.items(), rope_stops.items(), cert)

// No certificate: the replay finds its own order.
func any_order() -> ?[]i32 => (0 as [*]i32, 0:u32)  // enum: none

// Copies a certificate into one of the lists that last for the call.
func keep_moves(moves: []i32, into: *mut Vec(i32)) {
  into.clear()
  assert moves.len <= into.cap  // reserve: a move per stop and one more per rope
  for i in moves {
    into.push(i)
  }
}

// Takes t as the board's certificate (result = t).
func take(t: *HexIntent) {
  keep_moves(t.moves, plan)
  plan_cost = t.cost
}

// Lays rope `id` for good: its cells go to the pool, where they outlive the step's scope, and
// are marked as its own. Its path, as kept.
func commit(id: i32, ids: []i32) -> []Pt {
  let start = pool.len
  assert start + ids.len <= pool.cap  // reserve: the ropes share no cell
  for c in ids {
    pool.push(hex_point(c, bw))
    occupied[c] = id
  }
  let path = pool.ptr[start..pool.len]
  ropes.ptr[id] = path  // unchecked: id < ropes.len
  covered += ids.len as i32
  return path
}

// A new rope of up to `want` cells, grown from its head backwards (shape()). Without an aim its
// head is a free cell at random (24 tries) and its direction is random. The second cell lies
// behind the head; then each cell turns at random among the free cells that neither the rope
// nor its way out holds, carrying straight on with chance 0.38. None if there is no room, if
// its way out passes a cell twice, or if it is shorter than two cells. In the caller's scope.
func shape(want: i32, aim: Aim) -> ?*Shape {
  let none = 0 as ?*Shape  // enum: none
  let head = aim.head
  if head < 0 {
    for t in 24 {
      let pick = gen.below(area)
      if free(pick) {
        head = pick
        break
      }
    }
  }
  return none when head < 0
  let dir = if aim.head >= 0 { aim.dir } else { gen.below(6) }
  let back = (dir + 3) % 6
  let second = step_to(head, back)
  return none when !free(second)
  let turns = vec(i32, bent.size() as u32)  // reserve: a mirror's cell once at most
  let ahead = vec(i32, 16)
  if bent.size() > 0 {
    return none when !ray_track(bw, bh, head, dir, bent, ahead, turns)
  } else {
    ray(head, dir, ahead)
  }
  stamp += 1
  let body = vec(i32, max(want, 2) as u32)
  body.push(head)
  body.push(second)
  seen[head] = stamp
  seen[second] = stamp
  for c in ahead.items() {
    forward[c] = stamp
  }
  return none when forward[second] == stamp
  let previous = back
  while (body.len as i32) < want {
    choices.fixed_clear()
    let tip = body.last_of()
    for d in 6 {
      let nc = step_to(tip, d as i32)
      if free(nc) && seen[nc] != stamp && forward[nc] != stamp {
        choices.fixed_push(d as i32)
      }
    }
    let options = choices.fixed_items()
    break when options.len == 0
    previous = if options.contains(previous) && gen.next() < 0.38 { previous } else { gen.one_of(options) }
    let grown = step_to(tip, previous)
    seen[grown] = stamp
    body.push(grown)
  }
  return none when body.len < 2
  let n = body.len
  let ids = alloc(n * 4) as [*]mut i32
  let path = alloc(n * sizeof(Pt)) as [*]mut Pt
  for j, cell in body.items() {  // closure: body.rev_in_place(), then body.map(c => points[c])
    ids[n - 1 - j] = cell
    path[n - 1 - j] = hex_point(cell, bw)
  }
  let s = alloc(sizeof(Shape)) as *mut Shape
  s.* = Shape(ids[0..n], path[0..n], ahead.items(), turns.items())
  return s
}

// Whether some cell of xs is in ys (xs.some(c => ys.includes(c))).
func crosses(xs: []i32, ys: []i32) -> bool {  // closure: a lambda in any()
  for c in xs {
    return true when ys.contains(c)
  }
  return false
}

// --- The repeated-slide core ---

// Lays the core: its ropes as given, each its stops, replayed by its certificate. False if a
// rope is shorter than two cells, leaves the board or crosses another, if a way out passes a
// cell twice (the JS throws, and the generator takes it as no board), or if the certificate
// fails.
func lay_core() -> bool {
  let used = zeroed(area as u32) as [*]mut u8
  let distinct = 0
  for path in cfg.initial_ropes {
    return false when path.len < 2
    for p in path {
      return false when !hex_inside(bw, bh, p) || used[hex_cell(p, bw)] != 0
    }
    for p in path {
      let c = hex_cell(p, bw)
      if used[c] == 0 {  // the JS counts the cells (used.size), not the points
        distinct += 1
      }
      used[c] = 1
    }
    let start = pool.len
    assert start + path.len <= pool.cap  // reserve: the core's own cells
    for p in path {  // closure: path.copy()
      pool.push(p)
    }
    ropes.push(pool.ptr[start..pool.len])
  }
  if let core = hex_compile(bw, bh, cfg.mirrors, ropes.items()) {
    for i in core.n {
      let offs = cfg.initial_stops[i] ?? no_stops()
      let cells = alloc(offs.len * 4) as [*]mut i32
      let track = core.tracks[i]  // unchecked: a rope
      for j, o in offs {  // closure: offs.map(o => core.tracks[i][o + core.lengths[i] - 1])
        cells[j] = track[o + core.lengths[i] - 1] ?? -1  // an offset off the track is no stop
      }
      rope_stops.push(cells[0..offs.len])
    }
  } else {
    return false
  }
  if let r = intent(cfg.initial_plan) {
    take(r)
  } else {
    return false
  }
  for i, path in ropes.items() {
    if let ps = path {
      for p in ps {
        occupied[hex_cell(p, bw)] = i as i32
      }
    }
  }
  covered = distinct
  for s in rope_stops.items() {  // closure: stops.filter(s => s.length > 0).length
    if s.len > 0 {
      knots += 1
    }
  }
  return true
}

// --- Knots: pairs of ropes that must wait on each other ---

// One attempt at a knot: two new ropes, each crossing the other's way out, laid if one of them
// can slide to a stop and the board still replays.
func knot_attempt() {
  let stage = cfg.stage
  let length = min(38, 7 + stage / 2)
  let base = 4 + stage / 14
  if let a = shape(base + gen.below(length), no_aim()) {
    for c in a.ids {
      occupied[c] = 9999
    }
    let bs = shape(base + gen.below(length), no_aim())
    for c in a.ids {
      occupied[c] = -1
    }
    if let b = bs {
      return when !crosses(a.ray, b.ids) || !crosses(b.ray, a.ids)
      let i = ropes.len as i32
      ropes.push(a.path)
      ropes.push(b.path)
      rope_stops.push(no_stops())
      rope_stops.push(no_stops())
      let board = hex_compile_exn(bw, bh, cfg.mirrors, ropes.items())
      let trial = 0 as ?*HexIntent  // enum: none
      for k in 2 {
        let id = i + k as i32
        let target = board.to(id)
        continue when target <= 0
        let track = board.tracks[id]  // unchecked: a rope
        stop1[id] = track[target + board.lengths[id] - 1] ?? -1
        rope_stops.ptr[id] = stop1[id as u32..id as u32 + 1]  // unchecked: id < stops.len
        trial = intent(any_order())
        if let t = trial {
          break
        }
        rope_stops.ptr[id] = no_stops()  // unchecked: id < stops.len
      }
      if let t = trial {
        take(t)
        knots += 1
        commit(i, a.ids)
        commit(i + 1, b.ids)
      } else {
        ropes.pop()
        ropes.pop()
        rope_stops.pop()
        rope_stops.pop()
      }
    }
  }
}

// --- Mirrors brought into play ---

// A head and direction that points a new rope at a mirror no laid rope turns on yet (aimAt()):
// the mirror at random, a direction it turns at random, one to three cells before it, all of
// them free. None if there is no such mirror, or no room.
func aim_at() -> Aim {
  let scope = mark()
  defer reset(scope)
  let ms = cfg.mirrors
  let idle = vec(Mirror, ms.len)
  for m in ms {  // closure: mirrors.filter(m => !turned_by[hex_cell(m.cell, w)])
    if turned_by[hex_cell(m.cell, bw)] == 0 {
      idle.push(m)
    }
  }
  return no_aim() when idle.len == 0
  let m = gen.one_of(idle.items())
  let c = hex_cell(m.cell, bw)
  dirs.fixed_clear()
  for e in 6 {  // closure: [0, 1, 2, 3, 4, 5].filter(e => e % 3 != m.kind % 3)
    if (e as i32) % 3 != m.kind % 3 {
      dirs.fixed_push(e as i32)
    }
  }
  let d = gen.one_of(dirs.fixed_items())
  let j = 1 + gen.below(3)
  let head = c
  let k = 0
  while k < j && head >= 0 {
    head = step_to(head, (d + 3) % 6)
    k += 1
  }
  let x = head
  k = 0
  while k < j && x >= 0 {
    return no_aim() when !free(x)
    k += 1
    x = step_to(x, d)
  }
  return if head >= 0 { Aim(head, d) } else { no_aim() }
}

// Marks the mirrors the way out of `path` turns on (noteTurns()).
func note_turns(path: []Pt) {
  return when bent.size() == 0
  let scope = mark()
  defer reset(scope)
  let t = vec(i32, bent.size() as u32)  // reserve: a mirror's cell once at most
  let out = vec(i32, 16)
  ray_track(bw, bh, hex_cell(last(path), bw), exit_index(bw, path, bent), bent, out, t)
  for c in t.items() {
    if turned_by[c] == 0 {
      turned_by[c] = 1
      turned_count += 1
    }
  }
}

// --- Traps ---

// A place for a trap: a free cell and a direction whose way out has an empty gap of one to
// three cells (kept at cells[at..at + gap]) before a laid rope.
type Spot = (c: i32, d: i32, gap: i32, at: u32)

// Whether cell x is on rope i's way out (wayOut[i].has(x)): a track passes no cell twice.
func on_way_out(b: *HexBoard, i: i32, x: i32) -> bool {
  let track = b.tracks[i]  // unchecked: a rope
  for c in track.ptr[b.lengths[i] as u32..track.len] {  // unchecked: the way out
    return true when c == x
  }
  return false
}

// Tries to lay a trap (tryTrap()): a rope aimed at a gap ahead, such that sliding it into the
// gap leaves some rope that can never leave. Gaps on the way out of the rope they stop against
// are fatal for both, so those are tried first. Sixteen tries at most.
func try_trap() -> bool {
  let scope = mark()
  defer reset(scope)
  let board = hex_compile_exn(bw, bh, cfg.mirrors, ropes.items())
  let room = (area * 6) as u32
  let spots = vec(Spot, room)  // reserve: one per cell and direction at most
  let deadly = vec(Spot, room)
  let cells = vec(i32, 3 * room)
  let ahead = vec(i32, (2 * area + 2) as u32)  // reserve: a way out of 2 * area cells at most
  for c in area {
    let cell = c as i32
    continue when !free(cell)
    for d in 6 {
      let dir = d as i32
      continue when !free(step_to(cell, (dir + 3) % 6))
      ahead.clear()
      continue when !ray(cell, dir, ahead)
      let way = ahead.items()
      let gap = 0
      while gap < way.len as i32 && gap < 4 && occupied[way.ptr[gap]] < 0 {  // unchecked: gap < len
        gap += 1
      }
      continue when gap < 1 || gap > 3 || gap >= way.len as i32 || occupied[way.ptr[gap]] < 0  // unchecked: gap < len
      let ok = true
      for x in way.ptr[0..gap as u32] {  // unchecked: gap < len
        if kept[x] != 0 {
          ok = false
        }
      }
      continue when !ok
      let at = cells.len
      for x in way.ptr[0..gap as u32] {
        cells.push(x)
      }
      let spot = Spot(cell, dir, gap, at)
      let blocker = occupied[way.ptr[gap]]
      spots.push(spot)
      if blocker < board.n {
        let fatal = board.on_way_out(blocker, cell)
        for x in way.ptr[0..gap as u32] {  // closure: cells.iter().any(x => wo[x])
          fatal = fatal || board.on_way_out(blocker, x)
        }
        if fatal {
          deadly.push(spot)
        }
      }
    }
  }
  let pool_of = if deadly.len > 0 { deadly } else { spots }
  for t in 16 {
    break when pool_of.len == 0
    let chosen = gen.one_of(pool_of.items())
    let want = 3 + i32(floor(gen.next() * max(2.0, f64(cfg.length) / 2.0)))
    let inner = mark()
    defer reset(inner)
    if let shaped = shape(want, Aim(chosen.c, chosen.d)) {
      let id = ropes.len as i32
      ropes.push(shaped.path)
      rope_stops.push(no_stops())
      let lost = false
      let trial = intent(any_order())
      if let tr = trial {
        let b = hex_compile_exn(bw, bh, cfg.mirrors, ropes.items())
        if b.to(id) == chosen.gap {
          b.place(id, chosen.gap)
          lost = b.dead()
        }
      }
      if lost {
        if let tr = trial {
          take(tr)
        }
        note_turns(commit(id, shaped.ids))
        for x in cells.ptr[chosen.at..chosen.at + chosen.gap as u32] {  // unchecked: the spot's cells
          kept[x] = 1
        }
        traps += 1
        return true
      }
      ropes.pop()
      rope_stops.pop()
    }
  }
  return false
}

// --- The builder ---

// Builds a woven Hex level (build()): the core if given, then the knots, then traps and long
// winding ropes until the cells are covered. Each rope is kept only if the board still replays
// with every stop; among twelve candidates the one kept is the one that adds the most waiting
// (cost, weighted by tap_depth), cells and mirrors brought into play. None if the core does
// not hold. Everything it returns is in the caller's scope.
export func hex_build(r: *mut Rng, c: *HexCfg) -> ?*HexBuilt {
  let w = c.w
  let h = c.h
  let cells = w * h
  assert w > 0 && h > 0 && cells < 0x1000000
  let core_cells: u32 = 0
  let core_stops: u32 = 0
  for p in c.initial_ropes {
    core_cells += p.len
  }
  for s in c.initial_stops {
    core_stops += s.len
  }
  // What is returned, in the caller's scope; the ropes share no cell.
  let rope_room = (cells / 2 + 2) as u32 + c.initial_ropes.len
  let move_room = 2 * rope_room + core_stops
  let out = alloc(sizeof(HexBuilt)) as *mut HexBuilt
  let out_ropes = alloc(rope_room * sizeof([]Pt)) as [*]mut []Pt
  let out_stops = alloc(rope_room * sizeof([]i32)) as [*]mut []i32
  let out_plan = vec(i32, move_room)
  let stop_room = core_stops + rope_room
  let stop_cells = alloc(stop_room * 4) as [*]mut i32
  pool = vec(Pt, cells as u32 + core_cells)
  let scope = mark()
  defer reset(scope)
  gen = r
  cfg = c
  bw = w
  bh = h
  area = cells
  plan = vec(i32, move_room)
  plan_cost = 0
  best_ids = vec(i32, cells as u32 + 2)
  best_moves = vec(i32, move_room)
  ropes = vec(?[]Pt, rope_room)
  rope_stops = vec([]i32, rope_room)
  stop1 = table(rope_room as i32, -1)
  nb = alloc((cells * 6) as u32 * 4) as [*]mut i32
  for k in cells {  // closure: Array::makei(area, c => FixedArray::makei(6, d => ...))
    let pk = hex_point(k as i32, w)
    for d in 6 {
      let dv = hex_dir(d as i32)
      let q = Pt(pk.q + dv.q, pk.r + dv.r)
      nb[k * 6 + d] = if hex_inside(w, h, q) { hex_cell(q, w) } else { -1 }
    }
  }
  occupied = table(cells, -1)
  seen = table(cells, 0)
  forward = table(cells, 0)
  tile = zeroed(cells as u32) as [*]mut u8
  kept = zeroed(cells as u32) as [*]mut u8
  turned_by = zeroed(cells as u32) as [*]mut u8
  turned_count = 0
  bent = hex_mirrors(w, h, c.mirrors)
  for m in bent.keys.items() {
    tile[m] = 1
  }
  stamp = 0
  covered = 0
  knots = 0
  traps = 0

  // The optional repeated-slide core, replayed before anything is added.
  if c.initial_ropes.len > 0 {
    return 0 as ?*HexBuilt when !lay_core()  // enum: none
  }
  // Knots: each pair has a true mutual wait, at least one of its ropes must slide.
  let attempt = 0
  while attempt < max(5000, cells * 24) && knots < c.knots {
    attempt += 1
    let knot_scope = mark()
    defer reset(knot_scope)
    knot_attempt()
  }
  // Long, winding additions that make many laid ropes wait: the best of twelve candidates.
  for p in ropes.items() {
    if let path = p {
      note_turns(path)
    }
  }
  let attempts = 0
  let limit = cells * 22
  while f64(covered) < f64(cells) * c.coverage && attempts < limit {
    continue when traps < c.traps && ropes.len >= 2 && gen.next() < 0.5 && try_trap()
    let found = false
    let best_gain = 0.0
    let aim = bent.size() > turned_count
    let n = 0
    while n < 12 {
      let old = attempts
      attempts += 1
      break when !(old < limit)
      let want = 4 + i32(floor((0.45 + 0.55 * gen.next()) * f64(c.length)))
      let spot = if aim && n < 4 { aim_at() } else { no_aim() }
      n += 1
      let cand = mark()
      defer reset(cand)
      if let s = shape(want, spot) {
        ropes.push(s.path)
        rope_stops.push(no_stops())
        let trial = intent(any_order())
        ropes.pop()
        rope_stops.pop()
        if let t = trial {
          let fresh = 0
          for x in s.turns {
            if turned_by[x] == 0 {
              fresh += 1
            }
          }
          let gain = f64(t.cost - plan_cost) * (c.tap_depth - 1.0) + f64(s.ids.len * 4) + f64(30 * fresh)
          if !found || gain > best_gain {
            found = true
            best_gain = gain
            keep_moves(s.ids, best_ids)
            keep_moves(t.moves, best_moves)
            best_cost = t.cost
          }
        }
      }
    }
    continue when !found
    let id = ropes.len as i32
    ropes.push(pool.ptr[0..0])  // its place, until commit lays it
    rope_stops.push(no_stops())
    let path = commit(id, best_ids.items())
    keep_moves(best_moves.items(), plan)
    plan_cost = best_cost
    note_turns(path)
  }
  // The certificate of the board as laid, replayed once more: its layers are the stats.
  if let certified = intent(plan.items()) {
    let count = ropes.len
    let at = 0:u32
    for i, rp in ropes.items() {
      out_ropes[i] = rp ?? pool.ptr[0..0]  // every rope laid is there
      let sl = rope_stops.ptr[i]  // unchecked: i < count
      assert at + sl.len <= stop_room  // reserve: the stops given
      for j, x in sl {
        stop_cells[at + j] = x
      }
      out_stops[i] = stop_cells[at..at + sl.len]
      at += sl.len
    }
    keep_moves(plan.items(), out_plan)
    out.* = HexBuilt(out_ropes[0..count], out_stops[0..count], out_plan.items(), knots, traps, certified.depth, certified.cost)
    return out
  }
  assert false  // Hex weaving certificate failed (MoonBit aborts, the JS throws)
  return 0 as ?*HexBuilt
}

// --- Tests ---

// Paths from words q, r, ... cut at the given lengths.
func paths_of(words: []i32, lens: []i32) -> []?[]Pt {
  let pts = alloc(words.len * 4) as [*]mut Pt
  for k in words.len / 2 {
    pts[k] = Pt(words[2 * k] ?? 0, words[2 * k + 1] ?? 0)
  }
  let out = alloc(lens.len * sizeof(?[]Pt)) as [*]mut ?[]Pt
  let at: u32 = 0
  for i, l in lens {
    out[i] = pts[at..at + l as u32]
    at += l as u32
  }
  return out[0..lens.len]
}

func no_mirrors() -> []Mirror => (alloc(0) as [*]Mirror)[0..0]

test "a rope slides to its stop, then leaves" {
  let scope = mark()
  defer reset(scope)
  // on a 5 x 1 board: rope 0 on cells 0, 1 heads +q into rope 1 on cells 3, 4, which leaves
  // at once. With rope 0 to stop with its head on cell 2, only the order 0, 1, 0 works.
  let paths = paths_of([0:i32, 0, 1, 0, 3, 0, 4, 0], [2:i32, 2])
  let stop_cells = alloc(4) as [*]mut i32
  stop_cells[0] = 2
  let st = alloc(2 * sizeof([]i32)) as [*]mut []i32
  st[0] = stop_cells[0..1]
  st[1] = stop_cells[0..0]
  let order = alloc(12) as [*]mut i32
  order[0] = 0
  order[1] = 1
  order[2] = 0
  if let t = hex_intentions(5, 1, no_mirrors(), paths, st[0..2], order[0..3]) {
    // rope 0 waits on rope 1 (layer 1), rope 1 leaves at layer 1, then rope 0 at layer 2
    assert t.moves.len == 3 && t.cost == 3 && t.depth == 2 && t.slides == 1
  } else {
    assert false
  }
  assert hex_intentions(5, 1, no_mirrors(), paths, st[0..2], any_order()) == 0  // 1 leaves first: 0 cannot stop
  assert hex_intentions(5, 1, no_mirrors(), paths, st[0..2], order[0..2]) == 0  // the board is not empty
  st[0] = stop_cells[0..0]
  if let t = hex_intentions(5, 1, no_mirrors(), paths, st[0..2], any_order()) {
    assert t.moves.len == 2 && (t.moves[0] ?? -1) == 1 && t.cost == 3 && t.slides == 0
  } else {
    assert false
  }
}

test "a build replays by its own plan" {
  let scope = mark()
  defer reset(scope)
  let r = alloc(sizeof(Rng)) as *mut Rng
  r.* = Rng(12345)
  let no_ropes = alloc(0) as [*][]Pt
  let lists = alloc(0) as [*][]i32
  let c = alloc(sizeof(HexCfg)) as *mut HexCfg
  c.* = HexCfg(7, 8, 20, 0.99, 14, 1.6, no_mirrors(), 1, 1, no_ropes[0..0], lists[0..0], any_order())
  if let b = hex_build(r, c) {
    let covered_cells: u32 = 0
    for p in b.ropes {
      covered_cells += p.len
    }
    assert b.ropes.len >= 2 && covered_cells <= 56 && b.plan.len >= b.ropes.len
    let ps = alloc(b.ropes.len * sizeof(?[]Pt)) as [*]mut ?[]Pt
    for i, p in b.ropes {
      ps[i] = p
    }
    if let t = hex_intentions(7, 8, no_mirrors(), ps[0..b.ropes.len], b.stops, b.plan) {
      assert t.depth == b.depth && t.cost == b.cost
    } else {
      assert false
    }
  } else {
    assert false
  }
}
