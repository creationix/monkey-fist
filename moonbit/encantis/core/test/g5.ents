// The entry of G5's oracle (oracle/check-g5.cjs): the ABI buffers, draws(), stack_peak(), a t_
// hook for each unit of mech.ents and assist.ents, and gen.mbt's own guide and features exports,
// so that the game's glue (web/generator.js) drives this module as it drives dist/gen.wasm
// (oracle/setup-harness.sh, then moonbit/tests/assist.test.cjs). Each hook reads the position in
// the input (read_position's words: the board, the current paths, and a plan in the place of the
// preferred order) and clears the stack first, as every export of the core does.

import "../lib/stack" (
  "clear" func clear()
  "peak" func peak() -> u32
  "mark" func mark() -> u32
  "reset" func reset(m: u32)
)
import "../lib/vec" (
  "Vec" func Vec(comptime T: type) -> type
)
import "../random" (
  "draws" func draws_made() -> u32
)
import "../board" (
  "some_paths" func some_paths(ropes: [][]Pt) -> []?[]Pt
)
import "../abi" (
  "in_reset" func abi_in_reset()
  "in_push" func abi_in_push(c: i32)
  "out_len" func abi_out_len() -> i32
  "out_get" func abi_out_get(i: i32) -> i32
  "outf_get" func abi_outf_get(i: i32) -> f64
  "out_clear" func out_clear()
  "put" func put(w: i32)
  "read_position" func read_position() -> (board: Board, paths: []?[]Pt, prefer: []i32)
)
import "../mech" (
  "geo" func geo(b: Board) -> *mut Geo
  "direction" func direction(g: *Geo, path: []Pt) -> Pt
  "tap" func tap(g: *mut Geo, paths: []?[]Pt, i: i32) -> ?*Move
  "all_free_full" func all_free_full(g: *mut Geo, paths: []?[]Pt) -> bool
  "solve_full" func solve_full(g: *mut Geo, paths: []?[]Pt, budget: i32, prefer: []i32) -> Solved
  "tracked" func tracked(g: *mut Geo) -> bool
  "all_free" func all_free(g: *mut Geo, paths: []?[]Pt) -> bool
  "replay" func replay(g: *mut Geo, moves: []i32, paths: []?[]Pt) -> Replayed
  "solve" func solve(g: *mut Geo, paths: []?[]Pt, budget: i32, prefer: []i32) -> Solved
  "frozen" func frozen(g: *mut Geo, paths: []?[]Pt) -> []i32
  "minimum_taps" func minimum_taps(g: *mut Geo, fallback: []i32, budget: i32) -> ?*Par
)
import "../assist" (
  "guide" func assist_guide(g: *mut Geo, paths: []?[]Pt, budget: i32, prefer: []i32) -> Solved
  "reachable_features" func reachable_features(g: *mut Geo, paths: []?[]Pt, budget: i32) -> []i32
)

// --- The canonical type block ---
type Pt = (q: i32, r: i32)
type Mirror = (cell: Pt, kind: i32)       // kind: the axis on Hex; 1 for '\', 0 for '/' on square
type Board = (hex: bool, w: i32, h: i32, ropes: [][]Pt, mirrors: []Mirror, springs: []Pt, plan: []i32)
// --- end of the canonical type block ---
type SqMirrors = (slope: [*]mut i32, cells: i32, keys: *mut Vec(i32))
type Geo = (b: Board, hex: bool, w: i32, h: i32, mirror: [*]mut i32, spring: [*]mut u8, occ: [*]mut i32,
            stamp: i32, kernels: i32, sqm: *mut SqMirrors)
type Move = (paths: []?[]Pt, event: i32, distance: i32, route: []Pt)
type Solved = (solved: i32, moves: []i32, nodes: i32)
type Par = (plan: []i32, par: i32, exact: bool, nodes: i32)
type Replayed = (solved: bool, taps: i32, events: []i32, paths: []?[]Pt)

export memory

// --- The buffers ---

export func in_reset() {
  abi_in_reset()
}

export func in_push(c: i32) {
  abi_in_push(c)
}

export func out_len() -> i32 => abi_out_len()

export func out_get(i: i32) -> i32 => abi_out_get(i)

export func outf_get(i: i32) -> f64 => abi_outf_get(i)

export func draws() -> i32 => draws_made() as i32

export func stack_peak() -> i32 => peak() as i32

// --- The position in the input ---

// The board's tables, the paths and the plan (the preferred order's words).
type Pos = (g: *mut Geo, paths: []?[]Pt, plan: []i32)

func position() -> Pos {
  let (board:, paths:, prefer:) = read_position()
  return Pos(geo(board), paths, prefer)
}

// A counted list of words.
func put_list(xs: []i32) {
  put(xs.len as i32)
  for x in xs {
    put(x)
  }
}

func bit(b: bool) -> i32 => if b { 1 } else { 0 }

// FNV-1a over words, as check-g5.cjs hashes them.
func mix(h: u32, w: i32) -> u32 => (h ^ (w as u32)) * 0x01000193

// The words of a position's paths (per rope its length, 0 if gone, then q, r), hashed.
func paths_hash(paths: []?[]Pt) -> u32 {
  let h: u32 = 0x811c9dc5
  for p in paths {
    if let path = p {
      h = mix(h, path.len as i32)
      for c in path {
        h = mix(mix(h, c.q), c.r)
      }
    } else {
      h = mix(h, 0)
    }
  }
  return h
}

// The words of a position's paths, in full.
func put_paths(paths: []?[]Pt) {
  for path in paths {
    if let ps = path {
      put(ps.len as i32)
      for c in ps {
        put(c.q)
        put(c.r)
      }
    } else {
      put(0)
    }
  }
}

func put_solved(s: Solved) {
  put(s.solved)
  put(s.nodes)
  put_list(s.moves)
}

// --- The hooks ---

// G.tap(b, paths, i) for every rope: -1 for null; else the event (0 exit, 1 bounce, 2 slide),
// the distance, the route (counted), rope i's path after, and the hash of every path after.
export func t_taps() {
  clear()
  let p = position()
  out_clear()
  for i in p.paths.len {
    let scope = mark()
    defer reset(scope)
    if let m = p.g.tap(p.paths, i as i32) {
      put(m.event)
      put(m.distance)
      put(m.route.len as i32)
      for c in m.route {
        put(c.q)
        put(c.r)
      }
      put_paths(m.paths[i..i + 1] ?? m.paths)
      put(paths_hash(m.paths) as i32)
    } else {
      put(-1)
    }
  }
}

// G.direction(b, path) of every rope still there: dq, dr.
export func t_direction() {
  clear()
  let p = position()
  out_clear()
  for q in p.paths {
    if let path = q {
      let d = p.g.direction(path)
      put(d.q)
      put(d.r)
    }
  }
}

// G.allFree, routed.
export func t_free() -> i32 {
  clear()
  let p = position()
  return bit(p.g.all_free(p.paths))
}

// allFree of the full geometry, on any board.
export func t_free_full() -> i32 {
  clear()
  let p = position()
  return bit(p.g.all_free_full(p.paths))
}

// G.frozenRopes: counted.
export func t_frozen() {
  clear()
  let p = position()
  out_clear()
  put_list(p.g.frozen(p.paths))
}

// G.solve(b, paths, budget, plan): solved (1, 0, or -1 when the budget ran out), nodes, the moves.
export func t_solve(budget: i32) {
  clear()
  let p = position()
  out_clear()
  put_solved(p.g.solve(p.paths, budget, p.plan))
}

// The full-geometry solve on any board.
export func t_solve_full(budget: i32) {
  clear()
  let p = position()
  out_clear()
  put_solved(p.g.solve_full(p.paths, budget, p.plan))
}

// G.replay(b, plan, paths): solved, taps, the events (counted), the hash of the paths after, and
// the paths after in full.
export func t_replay() {
  clear()
  let p = position()
  out_clear()
  let r = p.g.replay(p.plan, p.paths)
  put(bit(r.solved))
  put(r.taps)
  put_list(r.events)
  put(paths_hash(r.paths) as i32)
  put_paths(r.paths)
}

// G.guide(b, paths, budget, plan): as t_solve.
export func t_guide(budget: i32) {
  clear()
  let p = position()
  out_clear()
  put_solved(p.g.assist_guide(p.paths, budget, p.plan))
}

// G.reachableFeatures(b, paths, budget): the feature indices, counted.
export func t_features(budget: i32) {
  clear()
  let p = position()
  out_clear()
  put_list(p.g.reachable_features(p.paths, budget))
}

// Whether the board runs on the kernels.
export func t_tracked() -> i32 {
  clear()
  let p = position()
  return bit(p.g.tracked())
}

// G.minimumTaps(b, plan, budget), from the board's start: 0 where the plan does not clear the
// board (the JS throws); else 1, writing par, exact, nodes and the plan (counted).
export func t_minimum(budget: i32) -> i32 {
  clear()
  let p = position()
  out_clear()
  if let m = p.g.minimum_taps(p.plan, budget) {
    put(m.par)
    put(bit(m.exact))
    put(m.nodes)
    put_list(m.plan)
    return 1
  }
  return 0
}

// --- gen.mbt's exports, for web/generator.js ---

// guide(budget): solved, nodes, then the moves (not counted).
export func guide(budget: i32) {
  clear()
  let p = position()
  let s = p.g.assist_guide(p.paths, budget, p.plan)
  out_clear()
  put(s.solved)
  put(s.nodes)
  for m in s.moves {
    put(m)
  }
}

// features(budget): the indices of the features in reach (mirrors first, then springs).
export func features(budget: i32) {
  clear()
  let p = position()
  let f = p.g.reachable_features(p.paths, budget)
  out_clear()
  for i in f {
    put(i)
  }
}

// --- Timing ---

// bench_solve of src/api: the board's tables, then solve from the start with no preferred order.
// The nodes.
export func t_bench_solve(budget: i32) -> i32 {
  clear()
  let (board:, paths:, prefer:) = read_position()
  let g = geo(board)
  return g.solve(some_paths(board.ropes), budget, prefer[0..0] ?? prefer).nodes
}
