// The entry of G1's oracle (oracle/check-g1.cjs): the ABI buffers, draws(),
// stack_peak(), and a t_ hook for each unit of G1. Every hook that allocates
// clears the stack first, as every export of the core does, except the keys
// hooks after t_keys_new / t_set_new, which keep their table between calls.

import "../lib/stack" (
  "clear" func clear()
  "peak" func peak() -> u32
  "alloc" func alloc(n: u32) -> u32
)
import "../lib/vec" (
  "Vec" func Vec(comptime T: type) -> type
)
import "../random" (
  "draws" func draws_made() -> u32
  "reset_draws" func reset_draws(on: bool)
  "next" func next(r: *mut Rng) -> f64
  "below" func below(r: *mut Rng, n: i32) -> i32
  "chance" func chance(r: *mut Rng, p: f64) -> bool
  "fnv" func fnv() -> u32
  "hash_byte" func hash_byte(h: u32, c: u8) -> u32
  "hash_text" func hash_text(s: []u8) -> u32
  "text" func text(comptime S: type, s: S, t: []u8, comptime put: (S, u8) -> S) -> S
  "dec" func dec(comptime S: type, s: S, v: i32, comptime put: (S, u8) -> S) -> S
  "base36" func base36(comptime S: type, s: S, u: u32, upper: bool, comptime put: (S, u8) -> S) -> S
  "js_round" func js_round(x: f64) -> f64
  "round_i" func round_i(x: f64) -> i32
  "floor_div" func floor_div(a: i32, b: i32) -> i32
)
import "../fmath" (
  "pow" func pow(x: f64, y: f64) -> f64
  "to_fixed" func to_fixed(x: f64, digits: u32) -> f64
)
import "../board" (
  "sq_mirrors" func sq_mirrors(b: *Board) -> *mut SqMirrors
  "at" func at(m: *SqMirrors, c: i32) -> i32
)
import "../keys" (
  "KeySet" func KeySet(comptime W: type) -> type
  "KeyMap" func KeyMap(comptime W: type, comptime V: type) -> type
  "keyset" func keyset(comptime W: type, keys: u32, words: u32) -> *mut KeySet(W)
  "add_key" func add_key(comptime W: type, s: *mut KeySet(W), key: []W) -> bool
  "has_key" func has_key(comptime W: type, s: *KeySet(W), key: []W) -> bool
  "keymap" func keymap(comptime W: type, comptime V: type, keys: u32, words: u32) -> *mut KeyMap(W, V)
  "set_key" func set_key(comptime W: type, comptime V: type, m: *mut KeyMap(W, V), key: []W, v: V) -> bool
  "get_key" func get_key(comptime W: type, comptime V: type, m: *KeyMap(W, V), key: []W, fallback: V) -> V
)
import "../journey" (
  "use_js_journey" func use_js_journey(on: bool)
)
import "../codes" (
  "parse_code" func parse_code(units: []i32) -> ?*SetOpts
  "code" func code(comptime S: type, s: S, o: *SetOpts, comptime put: (S, u8) -> S) -> S
  "level_spec" func level_spec(o: *SetOpts, index: i32) -> Spec
  "layout_json" func layout_json(comptime S: type, s: S, b: Board, comptime put: (S, u8) -> S) -> S
  "layout_key" func layout_key(comptime S: type, s: S, b: Board, comptime put: (S, u8) -> S) -> S
  "target_challenge" func challenge_target(d: f64) -> f64
  "win_ceiling" func ceiling(d: f64) -> f64
)
import "../abi" (
  "in_reset" func abi_in_reset()
  "in_push" func abi_in_push(c: i32)
  "out_len" func abi_out_len() -> i32
  "out_get" func abi_out_get(i: i32) -> i32
  "outf_get" func abi_outf_get(i: i32) -> f64
  "input" func input() -> []i32
  "input_bytes" func input_bytes() -> []u8
  "out_clear" func out_clear()
  "put" func put(w: i32)
  "putf" func putf(k: u32, x: f64)
  "put_byte" func put_byte(n: u32, c: u8) -> u32
  "put_string" func put_string(s: []u8)
  "begin_count" func begin_count() -> u32
  "end_count" func end_count(at: u32)
  "read_position" func read_position() -> (board: Board, paths: []?[]Pt, prefer: []i32)
  "read_level" func read_level(words: []i32) -> Level
  "put_level" func put_level(l: *Level)
)

// --- The canonical type block ---
type Pt = (q: i32, r: i32)
type Mirror = (cell: Pt, kind: i32)       // kind: the axis on Hex; 1 for '\', 0 for '/' on square
type Board = (hex: bool, w: i32, h: i32, ropes: [][]Pt, mirrors: []Mirror, springs: []Pt, plan: []i32)
type Spec = (hex: bool, w: i32, h: i32, difficulty: f64, mirrors: bool, springs: bool, seed: []u8,
             require_slide: bool, min_mirrors: i32, min_springs: i32, colossal: bool)
type Level = (board: Board, par: i32, exact: bool, coverage: f64, wins: f64, challenge: f64,
              slides: i32, bounces: i32, repeated: i32, automatic: i32,
              used_mirrors: i32, used_springs: i32, manual_mirrors: i32, manual_springs: i32)
// --- end of the canonical type block ---
type Rng = (a: u32)
type SqMirrors = (slope: [*]mut i32, cells: i32, keys: *mut Vec(i32))
type SetOpts = (journey: bool, grid: u8, min: i32, max: i32, w: i32, h: i32, count: i32,
                mirrors: bool, springs: bool, colossal: bool, seed: []u8)

export memory

// --- The buffers ---

export func in_reset() {
  abi_in_reset()
}

export func in_push(c: i32) {
  abi_in_push(c)
}

export func out_len() -> i32 => abi_out_len()

export func out_get(i: i32) -> i32 => abi_out_get(i)

export func outf_get(i: i32) -> f64 => abi_outf_get(i)

export func draws() -> i32 => draws_made() as i32

export func stack_peak() -> i32 => peak() as i32

// --- random ---

data cell = mut [0:u8; 8]

// Seeds the hooks' generator and starts the count of draws again.
export func t_seed(seed: i32) {
  let r = cell as *mut Rng
  r.* = Rng(seed as u32)
  reset_draws(false)
}

export func t_next() -> f64 => next(cell as *mut Rng)

export func t_below(n: i32) -> i32 => below(cell as *mut Rng, n)

export func t_chance(p: f64) -> i32 => if chance(cell as *mut Rng, p) { 1 } else { 0 }

// hashString of the input.
export func t_hash() -> i32 {
  clear()
  return hash_text(input_bytes()) as i32
}

// hashString('grid/3/' + input + '/' + i), streamed.
export func t_seed_hash(i: i32) -> i32 {
  clear()
  return fnv().text("grid/3/", hash_byte).text(input_bytes(), hash_byte).text("/", hash_byte).dec(i, hash_byte) as i32
}

// hashString('casual/' + input + '/' + attempt), streamed.
export func t_casual_hash(attempt: i32) -> i32 {
  clear()
  return fnv().text("casual/", hash_byte).text(input_bytes(), hash_byte).text("/", hash_byte).dec(attempt, hash_byte) as i32
}

// h.toString(36), upper-cased with upper, as output words.
export func t_b36(h: i32, upper: i32) {
  out_clear()
  base36(0:u32, h as u32, upper == 1, put_byte)
}

// --- numbers ---

export func t_pow(x: f64, y: f64) -> f64 => pow(x, y)

export func t_target(d: f64) -> f64 => challenge_target(d)

export func t_win(d: f64) -> f64 => ceiling(d)

export func t_round(x: f64) -> f64 => js_round(x)

export func t_round_i(x: f64) -> i32 => round_i(x)

export func t_to_fixed(x: f64, d: i32) -> f64 => to_fixed(x, d as u32)

export func t_floor_div(a: i32, b: i32) -> i32 => floor_div(a, b)

// --- codes ---

// The set of the code in the input: 1 and its fields, then its code as text; or 0.
export func t_parse() -> i32 {
  clear()
  out_clear()
  if let o = parse_code(input()) {
    put(if o.journey { 1 } else { 0 })
    put(o.grid as i32)
    put(o.min)
    put(o.max)
    put(o.w)
    put(o.h)
    put(o.count)
    put(if o.mirrors { 1 } else { 0 })
    put(if o.springs { 1 } else { 0 })
    put(if o.colossal { 1 } else { 0 })
    put_string(o.seed)
    let start = begin_count()
    code(0:u32, o, put_byte)
    end_count(start)
    return 1
  }
  return 0
}

// The spec of level i of the set of the code in the input: hex, W, H, mirrors,
// springs, require_slide, min_mirrors, min_springs, colossal, the seed; double 0 the
// difficulty. 0 for a code that is not valid. The Journey is the JS game's (grid-journey.js), whose
// specs check-g1 compares; the core's own Journey (journey.ents's specs_port) is G7's.
export func t_spec(i: i32) -> i32 {
  clear()
  use_js_journey(true)
  out_clear()
  if let o = parse_code(input()) {
    let s = level_spec(o, i)
    put(if s.hex { 1 } else { 0 })
    put(s.w)
    put(s.h)
    put(if s.mirrors { 1 } else { 0 })
    put(if s.springs { 1 } else { 0 })
    put(if s.require_slide { 1 } else { 0 })
    put(s.min_mirrors)
    put(s.min_springs)
    put(if s.colossal { 1 } else { 0 })
    put_string(s.seed)
    putf(0, s.difficulty)
    return 1
  }
  return 0
}

// --- the layout key ---

// The JSON text of the board in the input (a position), as output words.
export func t_layout_json() {
  clear()
  let (board:, paths:, prefer:) = read_position()
  out_clear()
  layout_json(0:u32, board, put_byte)
}

// The layout key of the board in the input, as output words.
export func t_layout_key() {
  clear()
  let (board:, paths:, prefer:) = read_position()
  out_clear()
  layout_key(0:u32, board, put_byte)
}

// --- SqMirrors ---

// The mirrors of the square board in the input: their cells in the order they were
// set, then the slope at every cell.
export func t_sq_mirrors() {
  clear()
  let (board:, paths:, prefer:) = read_position()
  let b = alloc(sizeof(Board)) as *mut Board
  b.* = board
  let m = sq_mirrors(b)
  out_clear()
  for c in m.keys.ptr[0..m.keys.len] {
    put(c)
  }
  for c in (board.w * board.h) as u32 {
    put(m.at(c as i32))
  }
}

// --- the ABI ---

// The position in the input read back: each current path (its length, then q, r;
// 0 for a rope that has left), then the preferred order, counted.
export func t_paths() {
  clear()
  let (board:, paths:, prefer:) = read_position()
  out_clear()
  put(paths.len as i32)
  for p in paths {
    if let q = p {
      put(q.len as i32)
      for c in q {
        put(c.q)
        put(c.r)
      }
    } else {
      put(0)
    }
  }
  put(prefer.len as i32)
  for i in prefer {
    put(i)
  }
}

data keep = mut [0:i32; 65536]

// The level of the board in the input (its plan the preferred order) with par,
// exact and stats 1 to 8, written by put_level; with again, read back from a copy of
// those words by read_level and written again.
export func t_level(par: i32, exact: i32, again: i32) {
  clear()
  let (board:, paths:, prefer:) = read_position()
  board.plan = prefer
  let l = alloc(sizeof(Level)) as *mut Level
  l.* = Level(board, par, exact == 1, 0.75, 0.25, 0.5, 1, 2, 3, 4, 5, 6, 7, 8)
  put_level(l)
  if again == 1 {
    let n = abi_out_len() as u32
    let k = keep as [*]mut i32
    for i in n {
      k[i] = abi_out_get(i as i32)  // unchecked: n <= 65536
    }
    l.* = read_level(k[0..n])
    l.wins = 0.25
    l.challenge = 0.5
    l.coverage = 0.75
    put_level(l)
  }
}

// --- the stack ---

// alloc(a), then alloc(b): where the second block starts (check-g1-wide.cjs's limits).
export func t_alloc(a: i32, b: i32) -> i32 {
  clear()
  alloc(a as u32)
  return alloc(b as u32) as i32
}

// --- keys ---

global map_at: u32 = 0
global set_at: u32 = 0

// A KeyMap(i32, i32) and a KeySet(i32) with room for keys keys of words words in all.
export func t_keys_new(keys: i32, words: i32) {
  clear()
  map_at = keymap(i32, i32, keys as u32, words as u32) as u32
  set_at = keyset(i32, keys as u32, words as u32) as u32
}

func the_map() -> *mut KeyMap(i32, i32) => map_at as *mut KeyMap(i32, i32)
func the_set() -> *mut KeySet(i32) => set_at as *mut KeySet(i32)

// Sets the value of the key in the input: 1 where the key is new.
export func t_keys_set(v: i32) -> i32 => if the_map().set_key(input(), v) { 1 } else { 0 }

export func t_keys_get(fallback: i32) -> i32 => the_map().get_key(input(), fallback)

export func t_keys_count() -> i32 => the_map().keys.count as i32

export func t_set_add() -> i32 => if the_set().add_key(input()) { 1 } else { 0 }

export func t_set_has() -> i32 => if the_set().has_key(input()) { 1 } else { 0 }
