// The entry of G6's oracle (oracle/check-g6.cjs): the ABI buffers, draws(), stack_peak(), and a t_
// hook for each unit of play.ents and metrics.ents. Each hook reads a board in the input
// (read_position's words: the board, its paths, which the hooks leave aside, and a plan in the place
// of the preferred order, which becomes the board's plan) and clears the stack first, as every export
// of the core does. t_seed keeps a seed text for t_measure.

import "../lib/stack" (
  "clear" func clear()
  "peak" func peak() -> u32
)
import "../lib/vec" (
  "Vec" func Vec(comptime T: type) -> type
)
import "../random" (
  "draws" func draws_made() -> u32
  "reset_draws" func reset_draws(on: bool)
  "rng" func new_rng(seed: u32) -> *mut Rng
)
import "../codes" (
  "target_challenge" func target_challenge(d: f64) -> f64
)
import "../abi" (
  "in_reset" func abi_in_reset()
  "in_push" func abi_in_push(c: i32)
  "out_len" func abi_out_len() -> i32
  "out_get" func abi_out_get(i: i32) -> i32
  "outf_get" func abi_outf_get(i: i32) -> f64
  "out_clear" func out_clear()
  "put" func put(w: i32)
  "putf" func putf(k: u32, x: f64)
  "input_bytes" func input_bytes() -> []u8
  "read_position" func read_position() -> (board: Board, paths: []?[]Pt, prefer: []i32)
)
import "../mech" (
  "geo" func geo(b: Board) -> *mut Geo
)
import "../play" (
  "coverage" func coverage(b: Board) -> f64
  "valid" func valid(g: *Geo) -> bool
  "regional" func regional(b: Board) -> bool
  "trivial" func trivial(g: *mut Geo) -> bool
  "features_used" func features_used(g: *mut Geo) -> bool
  "feature_stats" func feature_stats(g: *mut Geo, plan: []i32, manual: i32) -> ?*FeatureStats
  "slide_stats" func slide_stats(g: *mut Geo, plan: []i32, par: i32) -> SlideStats
  "postpone" func postpone(g: *mut Geo, plan: []i32) -> []i32
  "score" func score(g: *mut Geo, skip: bool) -> Par
  "casual_rate" func casual_rate(g: *mut Geo, r: *mut Rng, games: i32) -> f64
  "casual_measure" func casual_measure(b: Board, seed: []u8, games: i32) -> f64
  "bench_casual" func play_bench_casual(b: Board, games: i32) -> f64
  "bench_par" func play_bench_par(b: Board) -> i32
)
import "../metrics" (
  "analyze" func analyze(g: *mut Geo, plan: []i32, manual: i32) -> Complexity
)

// --- The canonical type block ---
type Pt = (q: i32, r: i32)
type Mirror = (cell: Pt, kind: i32)       // kind: the axis on Hex; 1 for '\', 0 for '/' on square
type Board = (hex: bool, w: i32, h: i32, ropes: [][]Pt, mirrors: []Mirror, springs: []Pt, plan: []i32)
// --- end of the canonical type block ---
type Rng = (a: u32)
type SqMirrors = (slope: [*]mut i32, cells: i32, keys: *mut Vec(i32))
type Geo = (b: Board, hex: bool, w: i32, h: i32, mirror: [*]mut i32, spring: [*]mut u8, occ: [*]mut i32,
            stamp: i32, kernels: i32, sqm: *mut SqMirrors)
type Par = (plan: []i32, par: i32, exact: bool, nodes: i32)
type FeatureStats = (used_mirrors: i32, used_springs: i32, manual_mirrors: i32, manual_springs: i32)
type SlideStats = (slides: i32, bounces: i32, repeated: i32, automatic: i32, any_slide: bool)
type Complexity = (interaction: f64, joins: i32, mutual: i32, revisited: i32, branching: i32, largest: i32)

export memory

// --- The buffers ---

export func in_reset() {
  abi_in_reset()
}

export func in_push(c: i32) {
  abi_in_push(c)
}

export func out_len() -> i32 => abi_out_len()

export func out_get(i: i32) -> i32 => abi_out_get(i)

export func outf_get(i: i32) -> f64 => abi_outf_get(i)

export func draws() -> i32 => draws_made() as i32

export func stack_peak() -> i32 => peak() as i32

// --- The board in the input ---

// The board, its plan the preferred order's words.
func board() -> Board {
  let (board: b, paths:, prefer:) = read_position()
  b.plan = prefer
  return b
}

func bit(b: bool) -> i32 => if b { 1 } else { 0 }

// A counted list of words.
func put_list(xs: []i32) {
  put(xs.len as i32)
  for x in xs {
    put(x)
  }
}

// --- The hooks ---

// F.coverage(b).
export func t_coverage() -> f64 {
  clear()
  return coverage(board())
}

// F.valid(b).
export func t_valid() -> i32 {
  clear()
  return bit(geo(board()).valid())
}

// regional(b) of grid-generator.js.
export func t_regional() -> i32 {
  clear()
  return bit(regional(board()))
}

// trivial(b, G) of grid-generator.js.
export func t_trivial() -> i32 {
  clear()
  return bit(geo(board()).trivial())
}

// featuresUsed(b, G) of grid-generator.js, b's plan being the plan in the input.
export func t_features_used() -> i32 {
  clear()
  return bit(geo(board()).features_used())
}

// F.featureStats(b, plan, manual, G): 0 for null; else 1, writing usedMirrors, usedSprings,
// manualMirrors, manualSprings.
export func t_feature_stats(manual: i32) -> i32 {
  clear()
  out_clear()
  let b = board()
  if let s = geo(b).feature_stats(b.plan, manual) {
    put(s.used_mirrors)
    put(s.used_springs)
    put(s.manual_mirrors)
    put(s.manual_springs)
    return 1
  }
  return 0
}

// The slideStats grid-generator.js's generate makes of the replay of plan with par manual taps:
// manualSlides, manualBounces, repeatedRopes, automaticRopes, and whether any tap slid.
export func t_slide_stats(par: i32) {
  clear()
  out_clear()
  let b = board()
  let s = geo(b).slide_stats(b.plan, par)
  put(s.slides)
  put(s.bounces)
  put(s.repeated)
  put(s.automatic)
  put(bit(s.any_slide))
}

// postpone(b, G, plan) of grid-generator.js: the plan, counted.
export func t_postpone() {
  clear()
  out_clear()
  let b = board()
  put_list(geo(b).postpone(b.plan))
}

// F.score(b, G, skip): par, exact, nodes, then the plan (counted).
export func t_score(skip: i32) {
  clear()
  out_clear()
  let p = geo(board()).score(skip == 1)
  put(p.par)
  put(bit(p.exact))
  put(p.nodes)
  put_list(p.plan)
}

// F.casualRate(b, G, mulberry32 at state, games): the win rate; draws() is the draws it made.
export func t_casual(games: i32, state: i32) -> f64 {
  clear()
  let r = new_rng(state as u32)
  let g = geo(board())
  reset_draws(false)
  return g.casual_rate(r, games)
}

// Q.analyze(b, plan, manual, G): the interaction; writes joins, mutualWaitRopes, revisitedRopes,
// branchingDepth, largestCoupledGroup.
export func t_analyze(manual: i32) -> f64 {
  clear()
  out_clear()
  let b = board()
  let c = geo(b).analyze(b.plan, manual)
  put(c.joins)
  put(c.mutual)
  put(c.revisited)
  put(c.branching)
  put(c.largest)
  return c.interaction
}

// The seed text of t_measure: the input's code units, kept.
data seed_text = mut [0:u8; 256]
global seed_len: u32 = 0

export func t_seed() {
  clear()
  let s = input_bytes()
  assert s.len <= 256
  for k, c in s {
    if let p = &seed_text[k] {
      p.* = c
    }
  }
  seed_len = s.len
}

// The Journey's stored measurement of a level (scripts/build-grid-journey.cjs measure()): the casual
// win rate over games games seeded by the kept seed text, returned; doubles 0 the win rate, 1 the
// challenge (work + 6 (1 - wins), work being the manual slides and bounces of the plan with par
// manual taps); draws() the draws made.
export func t_measure(par: i32, games: i32) -> f64 {
  clear()
  let b = board()
  let s = geo(b).slide_stats(b.plan, par)
  reset_draws(false)
  let wins = casual_measure(b, seed_text[0..seed_len] ?? "", games)
  putf(0, wins)
  putf(1, f64(s.slides + s.bounces) + 6.0 * (1.0 - wins))
  return wins
}

// F.targetChallenge(d).
export func t_target(d: f64) -> f64 => target_challenge(d)

// --- Timing (src/api's bench_casual and bench_par, on the board in the input) ---

export func t_bench_casual(games: i32) -> f64 {
  clear()
  return play_bench_casual(board(), games)
}

export func t_bench_par() -> i32 {
  clear()
  return play_bench_par(board())
}
